# IDE / Editors
# ------------------------------------------------------------

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.iml
*.ipr
*.iws

*.suo
*.user
*.userosscache
*.sln.docstates

# Vim
*.swp
*.swo
*~

# Emacs
*~

# ------------------------------------------------------------
# TypeScript
# ------------------------------------------------------------

*.tsbuildinfo

# ------------------------------------------------------------
