# CodeForge Backend Environment Variables Example

# ==========================================
# Server Configuration
# ==========================================
PORT=3002
NODE_ENV=development
# HOST=0.0.0.0
# LOG_LEVEL=info

# ==========================================
# Database Configuration
# ==========================================
# Local MongoDB or a MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/codeforge

# ==========================================
# Authentication
# ==========================================
# 32+ character random string for JWT signing
JWT_SECRET=your_super_secret_jwt_key_here

# Password of the "admin" account, seeded/synchronized at startup
ADMIN_API_KEY=your_admin_password_here

# Development only: skip JWT verification on admin routes.
# Ignored unless NODE_ENV=development.
# DEV_BYPASS_AUTH=false

# Optional per-client limits per minute (defaults: 100 and 5)
# RATE_LIMIT_MAX=100
# LOGIN_RATE_LIMIT_MAX=5

# ==========================================
# Frontend Connection
# ==========================================
# Extra origin for CORS and the CSRF guard
# (www.aesoul0.com and aesoul0.com are always allowed)
FRONTEND_URL=http://localhost:2003

# Optional: Vercel deploy hook called after content changes
# VERCEL_DEPLOY_HOOK_URL=

# ==========================================
# AI Documentation (at least one provider)
# ==========================================
# Tried first when set
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.6-flash

# Optional: higher GitHub API rate limit when reading repositories
# GITHUB_TOKEN=
