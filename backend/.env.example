# CodeForge Backend Environment Variables Example

# ==========================================
# Server Configuration
# ==========================================
PORT=3002
NODE_ENV=development

# ==========================================
# Database Configuration
# ==========================================
MONGODB_URI=mongodb://localhost:27017/codeforge

# ==========================================
# Authentication
# ==========================================
# 32+ character random string for JWT signing
JWT_SECRET=your_super_secret_jwt_key_here

# API Key for administrative scripts (e.g. seeding the DB)
ADMIN_API_KEY=your_admin_api_key_here

# ==========================================
# Frontend Connection
# ==========================================
FRONTEND_URL=http://localhost:2003

# ==========================================
# AI Provider (Google Gemini)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
