# ============================================================
# CodeForge test environment
# ============================================================

NODE_ENV=test

# Database
# Use a dedicated test database.
MONGODB_URI=mongodb://127.0.0.1:27017/codeforge_test

# Authentication
JWT_SECRET=codeforge-test-jwt-secret-change-me
JWT_ISSUER=codeforge
JWT_AUDIENCE=admin

# Admin test account
ADMIN_USERNAME=testadmin
ADMIN_PASSWORD=testpassword

# Frontend / CORS
FRONTEND_URL=http://localhost:2003

# Server
PORT=3002

# Development-only authentication bypass
DEV_BYPASS_AUTH=false

# External services
VERCEL_TOKEN=test-token
VERCEL_PROJECT_ID=test-project
GITHUB_TOKEN=test-token

# AI
AI_PROVIDER=test
OPENAI_API_KEY=test-key