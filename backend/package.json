{
  "name": "backend",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "add-project": "tsx src/services/scripts/add-project.ts",
    "test": "cross-env NODE_ENV=test dotenvx run -f .env.test --overload -- vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "env:test:check": "dotenvx run -f=.env.test -- node .env-check.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@dotenvx/dotenvx": "^1.71.0",
    "@fastify/cookie": "^10.0.0",
