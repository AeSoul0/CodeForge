{
  "type": "commonjs",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  },
  "description": "CodeForge backend API with Fastify and MongoDB",
  "main": "dist/index.js",
  "scripts": {
    "dev": "dotenvx run -f .env -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "add-project": "tsx src/services/scripts/add-project.ts",
    "test": "cross-env NODE_ENV=test dotenvx run -f .env.test --overload -- vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "env:test:check": "dotenvx run -f=.env.test -- node .env-check.cjs"
  },
  "keywords": [
    "fastify",
    "api",
    "portfolio",
    "backend"
  ],
  "author": "ÆSoul",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@dotenvx/dotenvx": "^2.21.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "bcrypt": "^6.0.0",
    "fastify": "^5.12.1",
    "mongoose": "^9.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild": true
  }
}
