{
    "compilerOptions": {
        "target": "es2022", 
        "module": "commonjs",
        "lib": [
            "es2022"
        ],
        "types": [
            "node"
        ],
        "outDir": "./dist", 
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "src/**/*",
        "tests/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}