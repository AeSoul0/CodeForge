---
/**
 * @file src/components/CoreCompetencies.astro
 * @description Compact skills section using lightweight skill chips.
 */

const skillGroups = [
    {
        name: "Core",
        skills: ["C++", "Python"],
    },
    {
        name: "Embedded",
        skills: [
            "RP2350",
            "FreeRTOS",
            "Real-Time Systems",
            "Sensor Integration",
        ],
    },
    {
        name: "Tools & OS",
        skills: ["CMake", "Git", "Linux", "Docker"],
    },
    {
        name: "IDE",
        skills: ["CLion", "VS Code", "Arduino"],
    },
    {
        name: "Web",
        skills: ["JavaScript", "React", "Node.js", "MongoDB"],
    },
];
---

<section
    id="skills"
    class="competencies-section relative z-10"
    aria-labelledby="competencies-title"
>
    <!-- ======================================================
	     HEADER
	     Same visual treatment as Recent Projects
	     ====================================================== -->

    <div class="flex items-center justify-between mb-8 relative z-10">
        <h2 id="competencies-title" class="text-3xl font-bold text-white">
            Core Competencies
        </h2>
    </div>

    <!-- ======================================================
	     SKILL GROUPS
	     ====================================================== -->

    <div class="competencies-list">
        {
            skillGroups.map((group, groupIndex) => (
                <div class="competency-group">
                    <div class="group-heading">
                        <span class="group-index">
                            {String(groupIndex + 1).padStart(2, "0")}
                        </span>

                        <span class="group-name">{group.name}</span>
                    </div>

                    <div class="skills-row">
                        {group.skills.map((skill) => (
                            <span class="skill-chip">{skill}</span>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>
</section>

<style>
    /* ======================================================
	   SECTION
	   ====================================================== */

    .competencies-section {
        padding: 0.75rem 0 1.25rem;

        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;

        text-rendering: optimizeLegibility;
    }

    /* ======================================================
	   GROUP LAYOUT
	   ====================================================== */

    .competencies-list {
        display: flex;
        flex-direction: column;
        gap: 1.15rem;
    }

    .competency-group {
        display: grid;
        grid-template-columns: 165px minmax(0, 1fr);
        align-items: center;
        gap: 1.5rem;

        min-height: 34px;
    }

    /* ======================================================
	   GROUP LABEL
	   ====================================================== */

    .group-heading {
        display: flex;
        align-items: baseline;
        gap: 0.7rem;
        min-width: 0;
    }

    .group-index {
        color: rgba(100, 116, 139, 0.7);

        font-size: 10px;
        font-weight: 700;

        letter-spacing: 0.12em;

        font-variant-numeric: tabular-nums;

        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    .group-name {
        color: rgba(241, 245, 249, 0.9);

        font-size: 12px;
        font-weight: 700;

        letter-spacing: 0.11em;
        text-transform: uppercase;

        white-space: nowrap;

        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    /* ======================================================
	   SKILL CHIPS
	   ====================================================== */

    .skills-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;

        min-width: 0;
    }

    .skill-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        min-height: 31px;
        padding: 0.42rem 0.78rem;

        border: 1px solid rgba(255, 255, 255, 0.09);
        border-radius: 0.58rem;

        background: rgba(255, 255, 255, 0.028);

        color: rgba(226, 232, 240, 0.9);

        font-size: 11px;
        font-weight: 600;

        letter-spacing: 0.01em;
        line-height: 1;

        transform: translate3d(0, 0, 0);

        transition:
            transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
            color 220ms ease,
            border-color 220ms ease,
            background-color 220ms ease,
            box-shadow 280ms ease;

        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;

        text-rendering: optimizeLegibility;
    }

    .skill-chip:hover {
        transform: translate3d(0, -2px, 0);

        color: rgba(207, 250, 254, 0.96);

        border-color: rgba(34, 211, 238, 0.2);

        background: rgba(34, 211, 238, 0.035);

        box-shadow:
            0 4px 10px rgba(0, 0, 0, 0.12),
            0 0 7px rgba(34, 211, 238, 0.035);
    }

    /* ======================================================
	   RESPONSIVE
	   ====================================================== */

    @media (max-width: 768px) {
        .competencies-list {
            gap: 1.2rem;
        }

        .competency-group {
            grid-template-columns: 1fr;
            gap: 0.65rem;
            min-height: auto;
        }

        .group-heading {
            gap: 0.6rem;
        }

        .group-index {
            font-size: 9px;
        }

        .group-name {
            font-size: 11px;
        }

        .skill-chip {
            min-height: 30px;
            padding-inline: 0.72rem;
            font-size: 10.5px;
        }
    }

    /* ======================================================
	   ACCESSIBILITY
	   ====================================================== */

    @media (prefers-reduced-motion: reduce) {
        .skill-chip {
            transition: none;
        }

        .skill-chip:hover {
            transform: none;
            box-shadow: none;
        }
    }
</style>
