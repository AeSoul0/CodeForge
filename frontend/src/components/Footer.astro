---
/**
 * @file src/components/Footer.astro
 * @description Application footer with final CTA and metadata.
 */
---

<footer class="relative z-10 w-full mt-10">
    <!-- CTA Section -->
    <div class="max-w-4xl mx-auto px-6 pt-10 pb-20 flex flex-col items-center justify-center text-center">
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-6">
            Have a problem <br class="sm:hidden" /><span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">worth building?</span>
        </h2>
        <p class="text-slate-400 text-lg max-w-xl text-center mb-10 leading-relaxed">
            I'm currently open to software engineering opportunities, internships and selected collaborations.
        </p>
        
        <a href="https://api.whatsapp.com/send?phone=393880555074" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 rounded-full bg-cyan-500 hover:bg-cyan-400 text-black px-8 py-4 text-sm font-bold transition-all hover:scale-105 shadow-[0_0_30px_rgba(34,211,238,0.3)]">
            Contact me
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>

        <div class="flex items-center justify-center gap-6 mt-12">
            <a href="mailto:samuele.arabia@example.com" class="text-sm font-semibold text-slate-400 hover:text-white transition-colors">Email</a>
            <a href="#" target="_blank" class="text-sm font-semibold text-slate-400 hover:text-white transition-colors">LinkedIn</a>
            <a href="https://github.com/SamueleArabia" target="_blank" class="text-sm font-semibold text-slate-400 hover:text-white transition-colors">GitHub</a>
            <a href="/CV.pdf" download="Samuele_Arabia_CV.pdf" class="text-sm font-semibold text-slate-400 hover:text-white transition-colors">CV</a>
        </div>
    </div>

    <!-- Metadata Section -->
    <div class="max-w-7xl mx-auto px-6 py-8 flex flex-col md:flex-row justify-between items-center gap-6 text-xs border-t border-white/5">
        <div class="text-slate-500">
            &copy; {new Date().getFullYear()}
            <span class="font-bold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500 ml-1">ÆSoul</span>. All rights reserved.
        </div>
        <div class="text-slate-600 font-mono tracking-wider">
            CodeForge v2.0
        </div>
    </div>
</footer>
