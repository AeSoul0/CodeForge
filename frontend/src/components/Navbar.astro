        <a
            href="https://api.whatsapp.com/send?phone=393880555074"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="social-link whatsapp"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path
                    d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
                ></path>
            </svg>
        </a>

        <a
            href="mailto:samuelearabia10@gmail.com"
            aria-label="Email"
            class="social-link mail"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                ></path>
                <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
        </a>
    </div>
</nav>

<style>

    /* ======================================================
       SQUIRCLE BADGE
       Superellipse (|x|^5 + |y|^5 = 1) sampled as a polygon. The badge is
       clipped to it (so the backdrop blur follows the shape) and the SVG
       path draws the same outline as fill + hairline, like the social pill.
       ====================================================== */
    .brand-squircle {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;

        width: 56px;
        height: 56px;
        padding: 2px;
        box-sizing: border-box;

        clip-path: polygon(100.00% 50.00%, 99.96% 66.80%, 99.83% 72.14%, 99.61% 76.01%, 99.31% 79.12%, 98.92% 81.75%, 98.44% 84.05%, 97.87% 86.08%, 97.20% 87.89%, 96.44% 89.52%, 95.58% 91.00%, 94.61% 92.33%, 93.53% 93.53%, 92.33% 94.61%, 91.00% 95.58%, 89.52% 96.44%, 87.89% 97.20%, 86.08% 97.87%, 84.05% 98.44%, 81.75% 98.92%, 79.12% 99.31%, 76.01% 99.61%, 72.14% 99.83%, 66.80% 99.96%, 50.00% 100.00%, 33.20% 99.96%, 27.86% 99.83%, 23.99% 99.61%, 20.88% 99.31%, 18.25% 98.92%, 15.95% 98.44%, 13.92% 97.87%, 12.11% 97.20%, 10.48% 96.44%, 9.00% 95.58%, 7.67% 94.61%, 6.47% 93.53%, 5.39% 92.33%, 4.42% 91.00%, 3.56% 89.52%, 2.80% 87.89%, 2.13% 86.08%, 1.56% 84.05%, 1.08% 81.75%, 0.69% 79.12%, 0.39% 76.01%, 0.17% 72.14%, 0.04% 66.80%, 0.00% 50.00%, 0.04% 33.20%, 0.17% 27.86%, 0.39% 23.99%, 0.69% 20.88%, 1.08% 18.25%, 1.56% 15.95%, 2.13% 13.92%, 2.80% 12.11%, 3.56% 10.48%, 4.42% 9.00%, 5.39% 7.67%, 6.47% 6.47%, 7.67% 5.39%, 9.00% 4.42%, 10.48% 3.56%, 12.11% 2.80%, 13.92% 2.13%, 15.95% 1.56%, 18.25% 1.08%, 20.88% 0.69%, 23.99% 0.39%, 27.86% 0.17%, 33.20% 0.04%, 50.00% 0.00%, 66.80% 0.04%, 72.14% 0.17%, 76.01% 0.39%, 79.12% 0.69%, 81.75% 1.08%, 84.05% 1.56%, 86.08% 2.13%, 87.89% 2.80%, 89.52% 3.56%, 91.00% 4.42%, 92.33% 5.39%, 93.53% 6.47%, 94.61% 7.67%, 95.58% 9.00%, 96.44% 10.48%, 97.20% 12.11%, 97.87% 13.92%, 98.44% 15.95%, 98.92% 18.25%, 99.31% 20.88%, 99.61% 23.99%, 99.83% 27.86%, 99.96% 33.20%);
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
    }

    .brand-squircle-shape {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    /* The stroke is centred on the clipped edge, so 2px shows as 1px. */
    .brand-squircle-shape path {
        fill: rgba(15, 23, 42, 0.3);
        stroke: rgba(255, 255, 255, 0.1);
        stroke-width: 2;
        vector-effect: non-scaling-stroke;
    }

    .brand-squircle img {
        position: relative;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    @media (min-width: 768px) {
        .brand-squircle {
            width: 64px;
            height: 64px;
        }
    }

    /* ======================================================
       FLUID TRANSITION OVERRIDES
       Sovrascrive il bounce globale con un ease-out super fluido
       ====================================================== */
    .social-link {
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }

    .social-link svg {
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }

    /* ======================================================
       HOVER STATES
       ====================================================== */
    .social-link.linkedin:hover {
        background-color: #0a66c2;
        color: #ffffff;
        transform: scale(1.08) translateY(-2px);
        box-shadow: 0 8px 20px rgba(10, 102, 194, 0.25);
    }

    .social-link.github:hover {
        background-color: #475569;
        color: #ffffff;
        transform: scale(1.08) translateY(-2px);
        box-shadow: 0 8px 20px rgba(71, 85, 105, 0.25);
    }

    .social-link.whatsapp:hover {
        background-color: #25d366;
        color: #ffffff;
        transform: scale(1.08) translateY(-2px);
        box-shadow: 0 8px 20px rgba(37, 211, 102, 0.25);
    }

    .social-link.mail:hover {
        background-color: #ef4444;
        color: #ffffff;
        transform: scale(1.08) translateY(-2px);
        box-shadow: 0 8px 20px rgba(239, 68, 68, 0.25);
    }
</style>
