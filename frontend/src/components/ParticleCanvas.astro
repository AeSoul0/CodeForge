---
/**
 * @file src/components/ParticleCanvas.astro
 * @description Self-contained HTML5 Canvas component computing real-time mouse interactive network node simulations.
 * Now optimized with IntersectionObserver to halt rendering when out of viewport.
 */
---

<!-- Interactive layer for cosmic/particle nodes -->
<canvas id="particleCanvas"></canvas>

<style>
    #particleCanvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        pointer-events: none;
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const canvas = document.getElementById("particleCanvas");
        if (!canvas) return;

        const ctx = canvas.getContext("2d");
        let w,
            h,
            particles = [];
        let mouse = { x: null, y: null };

        // Visibility state for performance optimization
        let isVisible = true;
        let animationFrameId = null;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        // Adaptive particle count based on screen size and motion preferences
        const getParticleCount = () => {
            if (prefersReducedMotion.matches) return 0;
            const width = window.innerWidth;
            if (width > 1024) return 55;   // Desktop
            if (width > 768) return 35;    // Tablet
            return 20;                     // Mobile
        };

        const initParticles = () => {
            particles = [];
            const count = getParticleCount();
            for (let i = 0; i < count; i++) {
                particles.push(new Particle());
            }
        };

        // Updates drawing bounds dynamically without disrupting viewport scaling
        const resize = () => {
            w = canvas.width = window.innerWidth;
            h = canvas.height = window.innerHeight;
            // Optionally, re-init particles if crossing breakpoints
            // For stability, we only set bounds here, but we can re-init too
            initParticles();
        };

        const onMouseMove = (e) => {
            mouse.x = e.clientX;
            mouse.y = e.clientY;
        };

        const onMouseOut = () => {
            mouse.x = null;
            mouse.y = null;
        };

        window.addEventListener("resize", resize);
        window.addEventListener("mousemove", onMouseMove);
        window.addEventListener("mouseout", onMouseOut);
        prefersReducedMotion.addEventListener("change", initParticles);

        // Particle structural node architecture
        class Particle {
            constructor() {
                this.x = Math.random() * w;
                this.y = Math.random() * h;
                this.vx = (Math.random() - 0.5) * 0.6;
                this.vy = (Math.random() - 0.5) * 0.6;
                this.baseColor =
                    Math.random() > 0.5 ? "6, 182, 212" : "99, 102, 241";
            }
            update() {
                this.x += this.vx;
                this.y += this.vy;

                // Rigid borders reflecting logic
                if (this.x < 0 || this.x > w) this.vx *= -1;
                if (this.y < 0 || this.y > h) this.vy *= -1;
            }
            draw() {
                ctx.beginPath();
                ctx.arc(this.x, this.y, 1.2, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(${this.baseColor}, 0.6)`;
                ctx.fill();
            }
        }

        // Initial setup
        resize();

        // Main execution rendering loop running inside the native animation thread
        function animate() {
            // Performance optimization: Pause computation when canvas is off-screen
            if (!isVisible || particles.length === 0) {
                if (animationFrameId) {
                    cancelAnimationFrame(animationFrameId);
                    animationFrameId = null;
                }
                // If particles exist but offscreen, we just return.
                // If no particles, we also don't animate.
                if (particles.length === 0) return;
                return;
            }

            ctx.clearRect(0, 0, w, h);

            for (let i = 0; i < particles.length; i++) {
                particles[i].update();
                particles[i].draw();

                // Compute structural vectors linking adjacent nodes
                for (let j = i + 1; j < particles.length; j++) {
                    let dx = particles[i].x - particles[j].x;
                    let dy = particles[i].y - particles[j].y;
                    let distance = Math.sqrt(dx * dx + dy * dy);

                    if (distance < 110) {
                        ctx.beginPath();
                        ctx.strokeStyle = `rgba(${particles[i].baseColor}, ${0.12 - distance / 900})`;
                        ctx.lineWidth = 0.7;
                        ctx.moveTo(particles[i].x, particles[i].y);
                        ctx.lineTo(particles[j].x, particles[j].y);
                        ctx.stroke();
                    }
                }

                // Draw physical links tracking coordinates to mouse positioning
                if (mouse.x !== null && mouse.y !== null) {
                    let dx = particles[i].x - mouse.x;
                    let dy = particles[i].y - mouse.y;
                    let distance = Math.sqrt(dx * dx + dy * dy);

                    if (distance < 160) {
                        ctx.beginPath();
                        ctx.strokeStyle = `rgba(6, 182, 212, ${0.25 - distance / 640})`;
                        ctx.lineWidth = 0.9;
                        ctx.moveTo(particles[i].x, particles[i].y);
                        ctx.lineTo(mouse.x, mouse.y);
                        ctx.stroke();
                    }
                }
            }
            animationFrameId = requestAnimationFrame(animate);
        }

        // Intersection Observer to monitor viewport visibility and preserve hardware resources
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    isVisible = entry.isIntersecting;
                    // Resume the animation loop if the canvas re-enters the viewport
                    if (isVisible && !animationFrameId && particles.length > 0) {
                        animate();
                    }
                });
            },
            { threshold: 0.05 },
        );

        observer.observe(canvas);

        // Trigger initial animation
        if (particles.length > 0) {
            animate();
        }

        // Lifecycle cleanup for SPA navigation
        document.addEventListener('astro:before-swap', () => {
            if (animationFrameId) cancelAnimationFrame(animationFrameId);
            observer.disconnect();
            window.removeEventListener("resize", resize);
            window.removeEventListener("mousemove", onMouseMove);
            window.removeEventListener("mouseout", onMouseOut);
            prefersReducedMotion.removeEventListener("change", initParticles);
        }, { once: true });
    });
</script>
