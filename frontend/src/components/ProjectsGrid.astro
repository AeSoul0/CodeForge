---
/**
 * @file src/components/ProjectsGrid.astro
 * @description Renders projects fetched from the backend with
 * multi-category filtering.
 */

export interface Project {
	_id: string;
	titolo: string;
	role?: string;
	descrizione: string;
	tecnologie: string[];
	categorie: string[];
	image?: string | null;
	experienceId?: string | null;
	experienceImage?: string | null;
	linkGithub?: string | null;
}

interface Props {
	projects: Project[];
	apiError?: boolean;
}

const { projects = [], apiError = false } = Astro.props;

/* ======================================================
   HELPERS
   ====================================================== */

const normalizeCategory = (category?: string) => {
	const value = (category || "").trim().toLowerCase();

	if (
		value === "full-stack" ||
		value === "full stack" ||
		value === "fullstack"
	) {
		return "full-stack";
	}

	if (value === "embedded") return "embedded";
	if (value === "ai") return "ai";
	if (value === "iot") return "iot";
	if (value === "data") return "data";

	return value;
};

const getCategoryLabel = (category: string) => {
	const normalized = normalizeCategory(category);

	switch (normalized) {
		case "full-stack":
			return "Full Stack";

		case "embedded":
			return "Embedded";

		case "ai":
			return "AI";

		case "iot":
			return "IoT";

		case "data":
			return "Data";

		default:
			return category;
	}
};

const projectCategories = projects.flatMap(
	(project) => {
		if (Array.isArray(project.categorie)) return project.categorie;
		if (typeof project.categoria === 'string') return [project.categoria];
		return [];
	}
);

const normalizedProjectCategories = [
	...new Set(projectCategories.map(normalizeCategory).filter(Boolean)),
];

const baseCategories = ["full-stack", "embedded", "ai", "iot", "data"];

const allCategories = [
	...baseCategories.filter((category) =>
		normalizedProjectCategories.includes(category),
	),
	...normalizedProjectCategories.filter(
		(category) => !baseCategories.includes(category),
	),
];
---

<section id="projects&experiences">
	<!-- ======================================================
	     HEADER
	     ====================================================== -->

	<div class="flex items-center justify-between mb-8 relative z-10">
		<h2 class="text-3xl font-bold text-white">Recent Projects</h2>
	</div>

	<!-- ======================================================
	     CATEGORY FILTERS
	     ====================================================== -->

	<div id="tech-filters" class="flex flex-wrap gap-2 mb-10 relative z-10">
		<button
			class="cat-btn active"
			data-filter="all"
			type="button"
			aria-pressed="true"
		>
			All Domains
		</button>

		{
			allCategories.map((category) => (
				<button
					class="cat-btn"
					data-filter={category}
					type="button"
					aria-pressed="false"
				>
					{getCategoryLabel(category)}
				</button>
			))
		}
	</div>

	<!-- ======================================================
	     PROJECT GRID
	     ====================================================== -->

	<div
		id="projects-container"
		class="grid grid-cols-1 md:grid-cols-2 gap-6"
	>
		{
			apiError ? (
				<div class="col-span-full py-12 text-center relative z-10 glass-card rounded-2xl border border-red-500/20 bg-red-500/5">
					<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-4 text-red-400 opacity-80"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
					<h3 class="text-xl font-bold text-white mb-2">Backend Connection Failed</h3>
					<p class="text-slate-400 max-w-md mx-auto">
						The free-tier Render backend is currently waking up or unavailable. 
						Please try refreshing the page in about 50 seconds.
					</p>
				</div>
			) : projects.length === 0 ? (
				<>
					<!-- Skeleton shown when no project data is available yet. -->
					<div class="project-skeleton" aria-hidden="true">
						<div class="skeleton-category"></div>
						<div class="skeleton-title"></div>
						<div class="skeleton-description"></div>
						<div class="skeleton-description short"></div>

						<div class="skeleton-badges">
							<span></span>
							<span></span>
							<span></span>
						</div>
					</div>

					<div class="project-skeleton" aria-hidden="true">
						<div class="skeleton-category"></div>
						<div class="skeleton-title"></div>
						<div class="skeleton-description"></div>
						<div class="skeleton-description short"></div>

						<div class="skeleton-badges">
							<span></span>
							<span></span>
							<span></span>
						</div>
					</div>
				</>
			) : (
				projects
					.filter(p => !p.titolo.toLowerCase().includes('codeforge'))
					.slice(0, 4) // Show only Tier 2 projects (max 4)
					.map((project) => {
					let rawCategories = [];
					if (Array.isArray(project.categorie)) {
						rawCategories = project.categorie;
					} else if (typeof project.categoria === 'string') {
						rawCategories = [project.categoria];
					}

					const categories = [
						...new Set(rawCategories.map(normalizeCategory)),
					].filter(Boolean);

					return (
						<article
							class="project-card glass-card hover-glow p-8 group relative overflow-hidden flex flex-col justify-between"
							data-categories={categories.join(",")}
						>
							{project.linkGithub && (
								<a
									href={project.linkGithub}
									target="_blank"
									rel="noopener noreferrer"
									class="github-link absolute top-6 right-6 z-20"
									title="View Code on GitHub"
									aria-label={`View ${project.titolo} on GitHub`}
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="20"
										height="20"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
										class="github-icon"
									>
										<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
									</svg>
								</a>
							)}

							<div class="relative z-10 mb-6">
								<div class="mb-3 flex flex-wrap gap-2">
									{categories.map((category) => (
										<span class="project-category text-[9px] font-black tracking-widest uppercase">
											{getCategoryLabel(category)}
										</span>
									))}
								</div>

								<h3 class="project-title text-2xl font-bold text-white mb-4 w-[90%] tracking-tight">
									{project.titolo}
								</h3>

								<!-- Role -->
								<div class="mb-4">
									<p class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold mb-1">Role</p>
									<p class="text-sm text-slate-300 font-medium">{project.role || (categories.includes('full-stack') ? 'Full-stack Engineer' : categories.includes('embedded') ? 'Embedded Systems Engineer' : 'Software Engineer')}</p>
								</div>

								<!-- Description -->
								<div class="mb-4">
									<p class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold mb-1">Description</p>
									<p class="text-sm text-slate-400 leading-relaxed line-clamp-2">
										{project.descrizione}
									</p>
								</div>
							</div>

							<!-- Stack -->
							<div class="mt-auto relative z-10">
								<p class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold mb-2">Stack</p>
								<div class="flex flex-wrap gap-2 mb-6">
									{(project.tecnologie ?? []).map(
										(technology) => (
											<span class="tech-badge px-2 py-1 text-[9px] font-bold rounded-full border uppercase">
												{technology}
											</span>
										),
									)}
								</div>

								<div class="flex items-center justify-between border-t border-white/10 pt-4 mt-2">
									<!-- Proof point -->
									<div class="flex items-center gap-2">
										<div class="w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,0.8)]"></div>
										<span class="text-xs font-semibold text-slate-300">
											{project.titolo.toLowerCase().includes('codeforge') ? '100/100 Lighthouse' : 
											 project.titolo.toLowerCase().includes('embedded') ? 'Hardware optimized' : 
											 'Project'}
										</span>
									</div>

									{(() => {
										const slug = project.titolo.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
										return (
											<a href={`/projects/${slug}`} class="text-xs font-bold text-cyan-400 hover:text-cyan-300 flex items-center gap-1 transition-colors group/link uppercase tracking-wider">
												View Case Study 
												<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover/link:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
											</a>
										);
									})()}
								</div>
							</div>
						</article>
					);
				})
			)
		}
	</div>
</section>

<style>
	.project-title,
	.project-category,
	.github-link,
	.github-icon,
	.tech-badge,
	.cat-btn {
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	.project-title {
		color: #ffffff !important;
		font-style: normal;
		font-synthesis: none;
		text-shadow: none !important;
	}

	.project-category {
		display: inline-block;
		padding: 0.25rem 0.55rem;
		border: 1px solid rgba(34, 211, 238, 0.12);
		border-radius: 9999px;
		color: #22d3ee;
		background: rgba(34, 211, 238, 0.045);
	}

	.project-card {
		position: relative;

		background:
			linear-gradient(
				135deg,
				rgba(30, 64, 175, 0.16),
				rgba(6, 182, 212, 0.07)
			),
			rgba(255, 255, 255, 0.03) !important;

		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);

		border-top: 1px solid rgba(255, 255, 255, 0.1);
		border-left: 1px solid rgba(255, 255, 255, 0.1);
		border-right: 1px solid rgba(255, 255, 255, 0.025);
		border-bottom: 1px solid rgba(255, 255, 255, 0.025);

		border-radius: 2rem;

		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);

		transform: translate3d(0, 0, 0);

		transition:
			transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 420ms cubic-bezier(0.22, 1, 0.36, 1),
			border-color 300ms ease;
	}

	.project-card:hover {
		transform: translate3d(0, -6px, 0);

		border-color: rgba(59, 130, 246, 0.55) !important;

		box-shadow:
			0 15px 35px rgba(0, 0, 0, 0.5),
			0 0 22px rgba(59, 130, 246, 0.18),
			inset 0 0 10px rgba(59, 130, 246, 0.04);
	}

	.github-link {
		display: grid;
		place-items: center;

		width: 26px;
		height: 26px;

		color: #64748b;

		transition: color 320ms ease;
	}

	.github-icon {
		display: block;

		width: 22px;
		height: 22px;

		transform-origin: center bottom;

		transition:
			transform 650ms cubic-bezier(0.16, 1, 0.3, 1),
			filter 650ms cubic-bezier(0.16, 1, 0.3, 1),
			color 320ms ease;
	}

	.github-link:hover {
		color: #f1f5f9;
	}

	.github-link:hover .github-icon {
		transform: translateY(-3px) scale(1.1);

		filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.12))
			drop-shadow(0 0 2px rgba(255, 255, 255, 0.06))
			drop-shadow(0 0 4px rgba(255, 255, 255, 0.02));
	}

	.github-link:active .github-icon {
		transform: translateY(-1px) scale(1.04);
	}

	.tech-badge {
		color: #a5f3fc;
		background-color: rgba(34, 211, 238, 0.045);
		border-color: rgba(34, 211, 238, 0.12);

		transition:
			transform 280ms cubic-bezier(0.22, 1.25, 0.36, 1),
			background-color 200ms ease,
			border-color 200ms ease,
			color 200ms ease;
	}

	.tech-badge:hover {
		transform: translateY(-2px) scale(1.03);

		color: #cffafe;
		background-color: rgba(34, 211, 238, 0.08);
		border-color: rgba(34, 211, 238, 0.22);
	}

	.cat-btn {
		position: relative;

		display: inline-flex;
		align-items: center;
		justify-content: center;

		min-height: 30px;
		padding: 0.42rem 0.8rem;

		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 9999px;

		background: rgba(255, 255, 255, 0.03);
		color: #cbd5e1;

		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1;

		transition:
			transform 280ms cubic-bezier(0.22, 1.25, 0.36, 1),
			background-color 220ms ease,
			color 220ms ease,
			border-color 220ms ease;
	}

	.cat-btn:hover {
		transform: translateY(-1px) scale(1.015);

		background: rgba(34, 211, 238, 0.045);
		border-color: rgba(34, 211, 238, 0.26);
		color: #67e8f9;
	}

	.cat-btn.active {
		background: rgba(34, 211, 238, 0.045);
		border-color: rgba(34, 211, 238, 0.28);
		color: #67e8f9;
	}

	/* ======================================================
	   SKELETON LOADER
	   ====================================================== */

	.project-skeleton {
		position: relative;
		min-height: 280px;
		padding: 2rem;
		overflow: hidden;

		border-radius: 2rem;

		background:
			linear-gradient(
				135deg,
				rgba(30, 64, 175, 0.11),
				rgba(6, 182, 212, 0.05)
			),
			rgba(255, 255, 255, 0.025);

		border-top: 1px solid rgba(255, 255, 255, 0.08);
		border-left: 1px solid rgba(255, 255, 255, 0.08);
		border-right: 1px solid rgba(255, 255, 255, 0.025);
		border-bottom: 1px solid rgba(255, 255, 255, 0.025);

		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);

		backdrop-filter: blur(20px) saturate(150%);
		-webkit-backdrop-filter: blur(20px) saturate(150%);
	}

	/* Animated highlight used by the loading placeholder. */
	.project-skeleton::after {
		content: "";
		position: absolute;
		inset: 0;

		background: linear-gradient(
			90deg,
			transparent,
			rgba(255, 255, 255, 0.035),
			transparent
		);

		transform: translateX(-100%);
		animation: skeleton-shimmer 1.8s ease-in-out infinite;

		pointer-events: none;
	}

	.skeleton-category,
	.skeleton-title,
	.skeleton-description,
	.skeleton-badges span {
		position: relative;
		z-index: 1;

		background: rgba(255, 255, 255, 0.07);

		animation: skeleton-pulse 1.6s ease-in-out infinite;
	}

	.skeleton-category {
		width: 72px;
		height: 22px;
		margin-bottom: 1rem;
		border-radius: 9999px;
	}

	.skeleton-title {
		width: 62%;
		height: 22px;
		margin-bottom: 1.25rem;
		border-radius: 9999px;
	}

	.skeleton-description {
		width: 90%;
		height: 11px;
		margin-bottom: 0.7rem;
		border-radius: 9999px;
	}

	.skeleton-description.short {
		width: 68%;
	}

	.skeleton-badges {
		position: absolute;
		left: 2rem;
		bottom: 2rem;

		display: flex;
		gap: 0.5rem;
	}

	.skeleton-badges span {
		width: 52px;
		height: 22px;
		border-radius: 9999px;
	}

	@keyframes skeleton-pulse {
		0%,
		100% {
			opacity: 0.3;
		}

		50% {
			opacity: 0.75;
		}
	}

	@keyframes skeleton-shimmer {
		0% {
			transform: translateX(-100%);
		}

		100% {
			transform: translateX(100%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-skeleton::after,
		.skeleton-category,
		.skeleton-title,
		.skeleton-description,
		.skeleton-badges span,
		.project-card,
		.github-link,
		.github-icon,
		.tech-badge,
		.cat-btn {
			animation: none;
			transition: none !important;
		}
	}
</style>

<script>
	const buttons = document.querySelectorAll(".cat-btn");

	const cards = document.querySelectorAll(".project-card");

	buttons.forEach((button) => {
		button.addEventListener("click", () => {
			buttons.forEach((btn) => {
				const active = btn === button;

				btn.classList.toggle("active", active);

				btn.setAttribute("aria-pressed", String(active));
			});

			const filter = button.getAttribute("data-filter") || "all";

			cards.forEach((card) => {
				const categories = (
					card.getAttribute("data-categories") || ""
				).split(",");

				const visible =
					filter === "all" ||
					categories.includes(filter);

				card.classList.toggle("hidden", !visible);
			});
		});
	});
</script>
