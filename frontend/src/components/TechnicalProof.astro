---
/**
 * @file src/components/TechnicalProof.astro
 * @description Technical credibility layer displaying architecture, security, quality and infrastructure.
 */
---

<section class="relative w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-16">
    <div class="mb-10 text-center sm:text-left">
        <h2 class="text-3xl font-bold text-white tracking-tight">
            Engineering Standards
        </h2>
        <p class="text-slate-400 mt-2">How I build production-oriented systems.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Architecture -->
        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/5 relative overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-br from-cyan-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <h3 class="text-[11px] font-black uppercase tracking-widest text-cyan-400 mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                Architecture
            </h3>
            <div class="space-y-3">
                <div class="flex items-center gap-2 text-sm text-slate-300 font-mono">
                    <span class="w-2 h-2 rounded-full bg-slate-600"></span> Model (HAL / Sensors)
                </div>
                <div class="flex items-center gap-2 text-sm text-slate-300 font-mono pl-4">
                    <span class="text-slate-600">↳</span> <span class="w-2 h-2 rounded-full bg-slate-500"></span> Presenter (Core Logic)
                </div>
                <div class="flex items-center gap-2 text-sm text-slate-300 font-mono pl-8">
                    <span class="text-slate-600">↳</span> <span class="w-2 h-2 rounded-full bg-cyan-500 shadow-[0_0_8px_rgba(34,211,238,0.5)]"></span> View (Actuators / UI)
                </div>
            </div>
        </div>

        <!-- Security -->
        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/5 relative overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-br from-cyan-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <h3 class="text-[11px] font-black uppercase tracking-widest text-cyan-400 mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                Security
            </h3>
            <div class="flex flex-wrap gap-2">
                <span class="px-2 py-1 text-[10px] font-bold rounded-md bg-white/5 text-slate-300 border border-white/10">JWT Auth</span>
                <span class="px-2 py-1 text-[10px] font-bold rounded-md bg-white/5 text-slate-300 border border-white/10">Secure Boot</span>
                <span class="px-2 py-1 text-[10px] font-bold rounded-md bg-white/5 text-slate-300 border border-white/10">Memory Isolation</span>
                <span class="px-2 py-1 text-[10px] font-bold rounded-md bg-white/5 text-slate-300 border border-white/10">Rate Limiting</span>
                <span class="px-2 py-1 text-[10px] font-bold rounded-md bg-white/5 text-slate-300 border border-white/10">Watchdog</span>
            </div>
        </div>

        <!-- Quality -->
        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/5 relative overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-br from-cyan-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <h3 class="text-[11px] font-black uppercase tracking-widest text-cyan-400 mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Quality
            </h3>
            <div class="flex flex-wrap gap-2">
                <span class="px-2 py-1 text-[10px] font-bold rounded-md bg-white/5 text-slate-300 border border-white/10">Vitest / Supertest</span>
                <span class="px-2 py-1 text-[10px] font-bold rounded-md bg-white/5 text-slate-300 border border-white/10">Catch2</span>
                <span class="px-2 py-1 text-[10px] font-bold rounded-md bg-white/5 text-slate-300 border border-white/10">HIL Testing</span>
                <span class="px-2 py-1 text-[10px] font-bold rounded-md bg-white/5 text-slate-300 border border-white/10">TypeScript Strict</span>
                <span class="px-2 py-1 text-[10px] font-bold rounded-md bg-white/5 text-slate-300 border border-white/10">CI Pipelines</span>
            </div>
        </div>

        <!-- Infrastructure -->
        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/5 relative overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-br from-cyan-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <h3 class="text-[11px] font-black uppercase tracking-widest text-cyan-400 mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
                Infrastructure
            </h3>
            <div class="flex flex-wrap gap-2">
                <span class="px-2 py-1 text-[10px] font-bold rounded-md bg-white/5 text-slate-300 border border-white/10">FreeRTOS / Linux</span>
                <span class="px-2 py-1 text-[10px] font-bold rounded-md bg-white/5 text-slate-300 border border-white/10">CMake</span>
                <span class="px-2 py-1 text-[10px] font-bold rounded-md bg-white/5 text-slate-300 border border-white/10">Docker</span>
                <span class="px-2 py-1 text-[10px] font-bold rounded-md bg-white/5 text-slate-300 border border-white/10">GitHub Actions</span>
                <span class="px-2 py-1 text-[10px] font-bold rounded-md bg-white/5 text-slate-300 border border-white/10">RP2350</span>
            </div>
        </div>
    </div>
</section>
