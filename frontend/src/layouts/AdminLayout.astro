---
/**
 * @file frontend/src/layouts/AdminLayout.astro
 * @description Shared layout for authenticated CodeForge administrator pages.
 *
 * The layout verifies the HttpOnly session through the backend on every
 * page (see src/lib/admin/layout.ts) and provides the navigation, a toast
 * live region and the shared confirmation dialog.
 */

import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

interface Props {
    title?: string;
}

const {
    title = 'CodeForge Admin',
} = Astro.props;

const navItems = [
    { href: '/admin/dashboard', label: 'Overview' },
    { href: '/admin/dashboard/projects', label: 'Projects' },
    { href: '/admin/dashboard/experiences', label: 'Experiences' },
    { href: '/admin/dashboard/api', label: 'API' },
    { href: '/admin/dashboard/system', label: 'System' },
];
---

<Layout title={title}>
    <div class="min-h-screen bg-transparent text-slate-200 relative z-10">
        <header class="border-b border-white/10 bg-black/40 p-4 sticky top-0 z-50 backdrop-blur-xl">
            <div class="container mx-auto flex justify-between items-center max-w-7xl gap-4">
                <a href="/admin/dashboard" class="font-black text-xl tracking-tight text-white">
                    CodeForge <span class="text-cyan-400">Admin</span>
                </a>

                <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300" aria-label="Admin navigation" data-admin-nav>
                    {navItems.map((item) => (
                        <a href={item.href} class="admin-nav-link hover:text-cyan-300 transition-colors">{item.label}</a>
                    ))}

                    <span class="text-xs text-slate-400 border-l border-white/10 pl-6" aria-label="Signed in user">
                        <span id="adminUser">…</span>
                    </span>

                    <button type="button" data-logout class="text-red-300 hover:text-red-200 transition-colors">
                        Logout
                    </button>
                </nav>

                <button
                    id="adminMenuToggle"
                    type="button"
                    class="md:hidden rounded-lg border border-white/10 px-3 py-2 text-sm text-slate-200"
                    aria-expanded="false"
                    aria-controls="adminMobileNav"
                >
                    Menu
                </button>
            </div>

            <nav id="adminMobileNav" class="hidden md:hidden container mx-auto max-w-7xl pt-4" aria-label="Admin navigation (mobile)" data-admin-nav>
                <ul class="flex flex-col gap-1 text-sm">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="admin-nav-link block rounded-lg px-3 py-2 hover:bg-white/5">{item.label}</a>
                        </li>
                    ))}
                    <li>
                        <button type="button" data-logout class="w-full text-left rounded-lg px-3 py-2 text-red-300 hover:bg-white/5">
                            Logout
                        </button>
                    </li>
                </ul>
            </nav>
        </header>

        <!-- Layout.astro already provides the page's <main> landmark. -->
        <div id="admin-content" class="container mx-auto max-w-7xl p-4 md:p-8">
            <slot />
        </div>
    </div>

    <div
        id="toastRegion"
        class="fixed bottom-4 right-4 z-[200] flex flex-col gap-2 max-w-sm"
        aria-live="polite"
    ></div>

    <dialog id="confirmDialog" class="admin-dialog" aria-labelledby="confirmTitle">
        <div class="glass-card p-6">
            <h2 id="confirmTitle" class="text-lg font-bold text-white mb-2">Are you sure?</h2>
            <p data-confirm-message class="text-sm text-slate-300 mb-6"></p>
            <div class="flex justify-end gap-3">
                <button type="button" data-confirm-cancel class="admin-btn-ghost">Cancel</button>
                <button type="button" data-confirm-accept class="rounded-full border border-red-400/50 bg-red-500/20 px-5 py-2 text-sm font-medium text-red-100 hover:bg-red-500/40">
                    Delete
                </button>
            </div>
        </div>
    </dialog>
</Layout>

<script>
    import { adminSession } from '../lib/admin/boot';

    void adminSession();
</script>
