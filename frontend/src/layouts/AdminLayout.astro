---
/**
 * @file frontend/src/layouts/AdminLayout.astro
 * @description Shared layout for authenticated CodeForge administrator pages.
 */

import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const {
    title = 'CodeForge Admin',
} = Astro.props;
---

<Layout title={title}>
    <div
        class="min-h-screen bg-transparent text-slate-200 relative z-10"
    >
        <header
            class="border-b border-white/10 bg-black/40 p-4 sticky top-0 z-50 backdrop-blur-xl"
        >
            <div
                class="container mx-auto flex justify-between items-center max-w-7xl"
            >
                <a
                    href="/admin/dashboard"
                    class="font-black text-xl tracking-tight text-white"
                >
                    CodeForge
                    <span class="text-cyan-400">
                        Admin
                    </span>
                </a>

                <nav
                    class="hidden md:flex gap-6 text-sm font-medium text-slate-300"
                    aria-label="Admin navigation"
                >
                    <a
                        href="/admin/dashboard/projects"
                        class="hover:text-cyan-300 transition-colors"
                    >
                        Projects
                    </a>

                    <a
                        href="/admin/dashboard/experiences"
                        class="hover:text-cyan-300 transition-colors"
                    >
                        Experiences
                    </a>

                    <a
                        href="/admin/dashboard/api"
                        class="hover:text-cyan-300 transition-colors"
                    >
                        API
                    </a>

                    <a
                        href="/admin/dashboard/system"
                        class="hover:text-cyan-300 transition-colors"
                    >
                        System
                    </a>

                    <button
                        id="logoutBtn"
                        type="button"
                        class="text-red-300 hover:text-red-200 transition-colors"
                    >
                        Logout
                    </button>
                </nav>
            </div>
        </header>

        <main
            class="container mx-auto max-w-7xl p-4 md:p-8"
        >
            <slot />
        </main>
    </div>
</Layout>

<script>
    document
        .getElementById('logoutBtn')
        ?.addEventListener(
            'click',
            async () => {
                try {
                    const apiUrl =
                        import.meta.env.PUBLIC_API_URL?.replace(
                            /\/$/,
                            '',
                        ) ||
                        'http://127.0.0.1:3002';

                    await fetch(
                        `${apiUrl}/api/auth/logout`,
                        {
                            method: 'POST',
                            credentials:
                                'include',
                        },
                    );
                } finally {
                    window.location.href =
                        '/admin/login';
                }
            },
        );
</script>