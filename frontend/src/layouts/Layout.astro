---
/**
 * @file src/layouts/Layout.astro
 * @description Master Layout establishing the global HTML skeleton,
 * typography, loader, ambient background, global UI utilities,
 * and SEO/OpenGraph metadata.
 */

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "CodeForge | ÆSoul",
	description = "Portfolio ufficiale di ÆSoul - Full-Stack Developer & Software Architect.",
} = Astro.props;

const canonicalUrl = Astro.url.href;
const ogImageUrl = new URL("/og-image.png", Astro.url).href;
---

<html lang="it" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />

		<link rel="icon" type="image/x-icon" href="/AeSoul_favicon.ico" />

		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- ======================================================
		     PRIMARY META TAGS
		     ====================================================== -->

		<title>{title}</title>

		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content="AeSoul" />

		<link rel="canonical" href={canonicalUrl} />

		<!-- ======================================================
		     OPEN GRAPH
		     ====================================================== -->

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content={title} />

		<!-- ======================================================
		     TWITTER / X
		     ====================================================== -->

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={title} />

		<style is:global>
			/* ======================================================
			   GLOBAL RESET
			   ====================================================== */

			html,
			body {
				margin: 0;
				padding: 0;
				background-color: #020617;
				color: #e2e8f0;

				font-family:
					"Segoe UI",
					Inter,
					ui-sans-serif,
					system-ui,
					-apple-system,
					BlinkMacSystemFont,
					sans-serif;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				text-rendering: optimizeLegibility;
			}

			/* ======================================================
			   ACCESSIBILITY
			   ====================================================== */

			:focus-visible {
				outline: 2px solid rgba(34, 211, 238, 0.9);
				outline-offset: 3px;
			}

			/* ======================================================
			   INITIAL GLOBAL LOADER
			   ====================================================== */

			#initial-loader {
				position: fixed;
				inset: 0;

				width: 100vw;
				width: 100dvw;

				height: 100vh;
				height: 100dvh;

				z-index: 99999;

				display: flex;
				align-items: center;
				justify-content: center;

				background: transparent;

				opacity: 1;
				visibility: visible;

				pointer-events: none;

				transition:
					opacity 280ms cubic-bezier(0.22, 1, 0.36, 1),
					visibility 280ms ease;
			}

			.loader-logo {
				width: 80px;
				height: 80px;

				display: flex;
				align-items: center;
				justify-content: center;

				filter:
					drop-shadow(0 0 18px rgba(6, 182, 212, 0.35))
					drop-shadow(0 0 32px rgba(6, 182, 212, 0.12));

				animation:
					loaderPulse 1.15s cubic-bezier(0.4, 0, 0.6, 1)
					infinite;

				transform: translate3d(0, 0, 0);

				will-change: transform, opacity;
			}

			.loader-logo img {
				display: block;

				width: 80px;
				height: 80px;

				object-fit: contain;

				transform: translate3d(0, 0, 0);

				backface-visibility: hidden;
				-webkit-backface-visibility: hidden;
			}

			#initial-loader.fade-out {
				opacity: 0;
				visibility: hidden;
			}

			@keyframes loaderPulse {
				0%,
				100% {
					transform: scale(1);
					opacity: 1;
				}

				50% {
					transform: scale(0.93);
					opacity: 0.76;
				}
			}

			/* ======================================================
			   GENERIC HOVER UTILITY
			   ====================================================== */

			.hover-glow {
				transition:
					transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
					box-shadow 0.42s cubic-bezier(0.22, 1, 0.36, 1),
					border-color 0.3s ease;
			}

			.hover-glow:hover {
				transform: translate3d(0, -6px, 0);

				border-color: rgba(255, 255, 255, 0.14) !important;

				box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
			}

			/* ======================================================
			   STATIC AMBIENT BACKGROUND
			   ====================================================== */

			/*
			 * The previous animated absolute blob was the only
			 * Lighthouse CLS culprit on the production homepage.
			 *
			 * The background is now painted by one fixed element
			 * with static radial gradients.
			 *
			 * No:
			 * - animation
			 * - absolute children
			 * - transform changes
			 * - layout-changing background elements
			 */

			.ambient-background {
				position: fixed;
				inset: 0;

				z-index: 0;

				pointer-events: none;

				opacity: 0.6;

				background:
					radial-gradient(
						circle at 8% 10%,
						rgba(37, 99, 235, 0.28) 0,
						rgba(37, 99, 235, 0.12) 20%,
						transparent 48%
					),
					radial-gradient(
						circle at 92% 28%,
						rgba(6, 182, 212, 0.2) 0,
						rgba(6, 182, 212, 0.08) 20%,
						transparent 46%
					);
			}

			/* ======================================================
			   GLASS CARD BASE
			   ====================================================== */

			.glass-card {
				position: relative;

				background: rgba(255, 255, 255, 0.03);

				backdrop-filter: blur(20px) saturate(160%);
				-webkit-backdrop-filter: blur(20px) saturate(160%);

				border-top: 1px solid rgba(255, 255, 255, 0.1);
				border-left: 1px solid rgba(255, 255, 255, 0.1);
				border-right: 1px solid rgba(255, 255, 255, 0.02);
				border-bottom: 1px solid rgba(255, 255, 255, 0.02);

				border-radius: 2rem;

				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);

				transition:
					transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
					box-shadow 0.42s cubic-bezier(0.22, 1, 0.36, 1),
					border-color 0.3s ease;
			}

			/* ======================================================
			   EXPLORE BUTTON
			   ====================================================== */

			.btn-explore {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;

				padding: 0.6rem 1.4rem;

				border-radius: 9999px;

				font-weight: 600;
				font-size: 0.8rem;

				color: #fff;

				background: rgba(6, 182, 212, 0.1);

				border: 1px solid rgba(6, 182, 212, 0.3);

				text-decoration: none;
				width: fit-content;

				transition:
					transform 0.3s cubic-bezier(0.22, 1.2, 0.36, 1),
					background-color 0.3s ease,
					border-color 0.3s ease;
			}

			.btn-explore:hover {
				background: rgba(6, 182, 212, 0.2);

				border-color: rgba(6, 182, 212, 0.8);

				transform: translate3d(0, -2px, 0) scale(1.03);
			}

			.btn-explore:active {
				transform: translate3d(0, 0, 0) scale(0.97);
			}

			/* ======================================================
			   SECTION DIVIDER
			   ====================================================== */

			.section-divider {
				width: 100%;
				height: 2px;

				margin: 2.5rem 0;

				background: linear-gradient(
					90deg,
					transparent 0%,
					rgba(6, 182, 212, 0.6) 50%,
					transparent 100%
				);

				box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
			}

			/* ======================================================
			   SOCIAL LINKS
			   ====================================================== */

			.social-link {
				position: relative;

				display: flex;
				align-items: center;
				justify-content: center;

				width: 36px;
				height: 36px;

				color: #94a3b8;

				text-decoration: none;

				border-radius: 50%;

				transition:
					background-color 0.3s ease,
					color 0.3s ease,
					box-shadow 0.3s ease;
			}

			.social-link svg {
				width: 18px;
				height: 18px;

				transition:
					transform 0.3s cubic-bezier(0.22, 1.2, 0.36, 1);
			}

			.social-link:hover {
				color: #fff;
			}

			.social-link:hover svg {
				transform: scale(1.15);
			}

			.social-link.linkedin:hover {
				background-color: #0a66c2;
				box-shadow: 0 0 20px rgba(10, 102, 194, 0.4);
			}

			.social-link.github:hover {
				background-color: #475569;
				box-shadow: 0 0 20px rgba(71, 85, 105, 0.4);
			}

			.social-link.whatsapp:hover {
				background-color: #25d366;
				box-shadow: 0 0 20px rgba(37, 211, 102, 0.4);
			}

			.social-link.mail:hover {
				background-color: #ef4444;
				box-shadow: 0 0 20px rgba(239, 68, 68, 0.4);
			}

			/* ======================================================
			   RESPONSIVE INTERACTION
			   ====================================================== */

			.tap-only {
				display: flex;
			}

			.hover-only {
				display: none;
			}

			@media (hover: hover) {
				.tap-only {
					display: none;
				}

				.hover-only {
					display: flex;
				}
			}

			/* ======================================================
			   TAP PULSE
			   ====================================================== */

			@keyframes pulse-fade-blur {
				0%,
				100% {
					opacity: 1;
					filter: blur(0);
				}

				50% {
					opacity: 0.6;
					filter: blur(0.5px);
				}
			}

			.animate-tap-pulse {
				animation: pulse-fade-blur 2s infinite ease-in-out;
			}

			/* ======================================================
			   ACCESSIBILITY
			   ====================================================== */

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}

				*,
				*::before,
				*::after {
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.01ms !important;
				}
			}
		</style>
	</head>

	<body
		class="min-h-screen flex flex-col relative selection:bg-cyan-500 selection:text-white overflow-x-hidden bg-[#020617]"
	>
		<!-- ======================================================
		     ACCESSIBILITY SKIP LINK
		     ====================================================== -->

		<a
			href="#main-content"
			class="absolute left-0 top-0 p-3 m-3 -translate-y-16 bg-blue-600 text-white z-[999999] transition focus:translate-y-0"
			aria-label="Skip to main content"
		>
			Skip to main content
		</a>

		<!-- ======================================================
		     INITIAL GLOBAL LOADER
		     ====================================================== -->

		<div id="initial-loader" aria-hidden="true">
			<div class="loader-logo">
				<img
					src="/AeSoul_logo-loader.webp"
					alt=""
					width="80"
					height="80"
					decoding="async"
				/>
			</div>
		</div>

		<!-- ======================================================
		     STATIC AMBIENT BACKGROUND
		     ====================================================== -->

		<div
			class="ambient-background"
			aria-hidden="true"
		></div>

		<!-- ======================================================
		     MAIN CONTENT
		     ====================================================== -->

		<main
			id="main-content"
			class="relative z-10 flex-1 w-full flex flex-col"
		>
			<slot />
		</main>

		<!-- ======================================================
		     LOADER SCRIPT
		     ====================================================== -->

		<script is:inline>
			(() => {
				const dismissLoader = () => {
					const loader =
						document.getElementById("initial-loader");

					if (
						!loader ||
						loader.classList.contains("fade-out")
					) {
						return;
					}

					loader.classList.add("fade-out");

					window.setTimeout(() => {
						loader.remove();
					}, 320);
				};

				/*
				 * The loader never waits for:
				 * - window.load
				 * - API calls
				 * - fonts
				 * - SVG decoding
				 *
				 * It is purely visual.
				 */

				if (document.readyState === "loading") {
					document.addEventListener(
						"DOMContentLoaded",
						() => {
							requestAnimationFrame(dismissLoader);
						},
						{ once: true },
					);
				} else {
					requestAnimationFrame(dismissLoader);
				}

				/*
				 * Safety fallback.
				 */
				window.setTimeout(dismissLoader, 700);
			})();
		</script>

		<!-- ======================================================
		     SECTION URL HASH OBSERVER
		     ====================================================== -->

		<script is:inline>
			(() => {
				const initSectionHashObserver = () => {
					const monitoredSectionIds = [
						"home",
						"projects&experiences",
					];

					const sectionElements = monitoredSectionIds
						.map((id) => document.getElementById(id))
						.filter(Boolean);

					if (!sectionElements.length) return;

					let currentHash =
						window.location.hash.replace("#", "");

					const observerOptions = {
						root: null,
						rootMargin: "-20% 0px -40% 0px",
						threshold: [0, 0.15, 0.3],
					};

					const observer = new IntersectionObserver(
						(entries) => {
							entries.forEach((entry) => {
								if (!entry.isIntersecting) return;

								const targetId = entry.target.id;

								if (
									targetId &&
									currentHash !== targetId
								) {
									currentHash = targetId;

									history.replaceState(
										null,
										"",
										`#${targetId}`,
									);
								}
							});
						},
						observerOptions,
					);

					sectionElements.forEach((section) => {
						observer.observe(section);
					});

					window.addEventListener(
						"scroll",
						() => {
							if (
								window.scrollY < 80 &&
								currentHash !== "home"
							) {
								currentHash = "home";

								history.replaceState(
									null,
									"",
									"#home",
								);
							}
						},
						{ passive: true },
					);
				};

				if (document.readyState === "loading") {
					document.addEventListener(
						"DOMContentLoaded",
						initSectionHashObserver,
						{ once: true },
					);
				} else {
					initSectionHashObserver();
				}
			})();
		</script>
	</body>
</html>