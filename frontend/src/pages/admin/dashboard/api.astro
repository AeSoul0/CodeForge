---
/**
 * @file frontend/src/pages/admin/dashboard/api.astro
 * @description API playground. Behaviour lives in src/lib/admin/playground.ts.
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="API Playground | Admin">
    <h1 class="text-3xl font-black tracking-tight text-white mb-6">API Playground</h1>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:min-h-[calc(100dvh-220px)]">
        <section class="flex flex-col glass-card p-4 gap-4" aria-labelledby="requestHeading">
            <h2 id="requestHeading" class="admin-label">Request</h2>

            <div>
                <label for="apiPreset" class="sr-only">Preset</label>
                <select id="apiPreset" class="admin-field font-mono text-sm"></select>
            </div>

            <div class="flex flex-wrap gap-2">
                <label for="apiMethod" class="sr-only">Method</label>
                <select id="apiMethod" class="admin-field w-28">
                    <option value="GET">GET</option>
                    <option value="POST">POST</option>
                    <option value="PATCH">PATCH</option>
                    <option value="DELETE">DELETE</option>
                </select>

                <label for="apiEndpoint" class="sr-only">Endpoint</label>
                <input id="apiEndpoint" type="text" value="/api/projects?limit=10" placeholder="/api/endpoint" class="admin-field flex-1 min-w-48 font-mono text-sm" />

                <button id="sendBtn" type="button" class="admin-btn-primary">Send</button>
            </div>

            <div class="flex-1 flex flex-col min-h-48">
                <label for="apiBody" class="admin-label">Request body (JSON)</label>
                <textarea id="apiBody" class="admin-field flex-1 font-mono text-sm resize-none" placeholder="{}" spellcheck="false"></textarea>
            </div>

            <div class="border-t border-white/10 pt-4">
                <div class="flex justify-between items-center mb-2">
                    <h3 class="admin-label mb-0">Request history</h3>
                    <button id="clearHistoryBtn" type="button" class="text-xs text-slate-400 hover:text-white">Clear</button>
                </div>
                <ul id="historyList" class="max-h-32 overflow-auto space-y-1"></ul>
            </div>
        </section>

        <section class="flex flex-col glass-card p-4 min-h-80" aria-labelledby="responseHeading">
            <div class="flex flex-wrap justify-between items-center gap-2 mb-4 border-b border-white/10 pb-4">
                <h2 id="responseHeading" class="admin-label mb-0">Response</h2>
                <div class="flex gap-4 text-sm font-mono" aria-live="polite">
                    <span id="resStatus" class="text-slate-400">Status: -</span>
                    <span id="resTime" class="text-slate-400">Time: -</span>
                </div>
            </div>

            <pre id="apiResponse" class="flex-1 overflow-auto bg-black/30 border border-white/10 rounded-xl p-4 text-sm font-mono text-slate-300 whitespace-pre-wrap break-words" tabindex="0">Ready to send request...</pre>
        </section>
    </div>
</AdminLayout>

<script>
    import { whenAuthenticated } from '../../../lib/admin/boot';
    import { initPlayground } from '../../../lib/admin/playground';

    void whenAuthenticated(() => initPlayground());
</script>
