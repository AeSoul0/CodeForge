---
/**
 * @file frontend/src/pages/admin/dashboard/experiences.astro
 * @description Experience management: list, create, edit, logo upload and
 * deletion. Behaviour lives in src/lib/admin/experiences.ts.
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Experiences | Admin">
    <div class="flex flex-wrap gap-4 justify-between items-center mb-6">
        <div>
            <h1 class="text-3xl font-black tracking-tight text-white">Experiences</h1>
            <p id="expCount" class="text-sm text-slate-400 mt-1" aria-live="polite"></p>
        </div>

        <button id="newExpBtn" type="button" class="admin-btn-primary">
            + New Experience
        </button>
    </div>

    <div class="glass-card overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
            <caption class="sr-only">Professional experiences</caption>
            <thead class="text-xs text-slate-300 uppercase bg-black/30 border-b border-white/10">
                <tr>
                    <th scope="col" class="pl-6 pr-2 py-4 w-20 font-medium"><span class="sr-only">Logo</span></th>
                    <th scope="col" class="px-6 py-4 font-medium">Role / Company</th>
                    <th scope="col" class="px-6 py-4 font-medium">Period</th>
                    <th scope="col" class="px-6 py-4 font-medium text-right">Actions</th>
                </tr>
            </thead>
            <tbody id="expTableBody">
                <tr>
                    <td colspan="4" class="px-6 py-6 text-center text-slate-400">Loading experiences…</td>
                </tr>
            </tbody>
        </table>
    </div>

    <dialog id="expDialog" class="admin-dialog" aria-labelledby="expDialogTitle">
        <form id="expForm" class="glass-card relative overflow-hidden" novalidate>
            <div class="flex justify-between items-center p-6 border-b border-white/10">
                <h2 id="expDialogTitle" class="text-xl font-bold text-white tracking-tight">New Experience</h2>
                <button type="button" data-dialog-close aria-label="Close dialog" class="text-2xl leading-none text-slate-400 hover:text-white">&times;</button>
            </div>

            <div class="p-6 space-y-4 max-h-[65dvh] overflow-y-auto">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="e-role" class="admin-label">Role *</label>
                        <input id="e-role" type="text" required minlength="2" maxlength="100" class="admin-field" />
                    </div>
                    <div>
                        <label for="e-company" class="admin-label">Company *</label>
                        <input id="e-company" type="text" required minlength="2" maxlength="100" class="admin-field" />
                    </div>
                </div>

                <div>
                    <label for="e-description" class="admin-label">Description *</label>
                    <textarea id="e-description" required minlength="10" maxlength="5000" rows="4" class="admin-field"></textarea>
                </div>

                <div>
                    <label for="e-technologies" class="admin-label">Technologies (comma separated)</label>
                    <input id="e-technologies" type="text" class="admin-field" />
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="e-startDate" class="admin-label">Start month *</label>
                        <input id="e-startDate" type="month" required class="admin-field" />
                    </div>
                    <div>
                        <label for="e-endDate" class="admin-label">End month</label>
                        <input id="e-endDate" type="month" class="admin-field" />
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <input id="e-current" type="checkbox" class="w-4 h-4" />
                    <label for="e-current" class="text-sm font-medium text-slate-300">I currently work here</label>
                </div>

                <div class="flex items-center gap-4">
                    <div class="w-20 h-20 shrink-0 rounded-xl overflow-hidden bg-white/5 border border-white/10 flex items-center justify-center">
                        <img id="e-imagePreview" alt="Logo preview" class="hidden w-full h-full object-contain bg-white p-1.5 transition-opacity" />
                        <span id="e-imagePlaceholder" class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">No logo</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <label for="e-image" class="admin-label">Organisation logo (JPEG, PNG or WebP, max 7 MB)</label>
                        <input id="e-image" type="file" accept="image/jpeg,image/png,image/webp" class="admin-field text-xs" />
                    </div>
                </div>

                <div data-remove-image class="hidden flex items-center gap-2">
                    <input id="e-removeImage" type="checkbox" class="w-4 h-4" />
                    <label for="e-removeImage" class="text-sm text-slate-300">Remove current logo</label>
                </div>

                <div id="expFormError" role="alert" class="hidden text-red-300 text-sm bg-red-500/10 border border-red-500/20 p-3 rounded-lg"></div>
            </div>

            <div class="flex justify-end gap-3 p-6 border-t border-white/10">
                <button type="button" data-dialog-close class="admin-btn-ghost">Cancel</button>
                <button type="submit" id="expSaveBtn" class="admin-btn-primary">Save</button>
            </div>
        </form>
    </dialog>
</AdminLayout>

<script>
    import { whenAuthenticated } from '../../../lib/admin/boot';
    import { initExperiencesPage } from '../../../lib/admin/experiences';

    void whenAuthenticated(() => initExperiencesPage().reload());
</script>
