---
/**
 * @file frontend/src/pages/admin/dashboard/index.astro
 * @description Protected administrator dashboard overview.
 *
 * The session is verified by AdminLayout against the backend before any
 * data is requested. The JWT remains HttpOnly and is never read from
 * client-side JavaScript.
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';

const stats = [
    { id: 'stat-projects', label: 'Projects', href: '/admin/dashboard/projects' },
    { id: 'stat-experiences', label: 'Experiences', href: '/admin/dashboard/experiences' },
    { id: 'stat-ai', label: 'Awaiting AI docs', href: '/admin/dashboard/projects' },
    { id: 'stat-backend', label: 'Backend', href: '/admin/dashboard/system' },
];

const sections = [
    {
        href: '/admin/dashboard/projects',
        title: 'Projects',
        text: 'Manage portfolio projects and generate AI descriptions.',
    },
    {
        href: '/admin/dashboard/experiences',
        title: 'Experiences',
        text: 'Manage work history, roles and organisation logos.',
    },
    {
        href: '/admin/dashboard/api',
        title: 'API Playground',
        text: 'Test endpoints directly from the browser.',
    },
    {
        href: '/admin/dashboard/system',
        title: 'System Status',
        text: 'Check backend, database health and runtime metrics.',
    },
];
---

<AdminLayout title="Dashboard | Admin">
    <h1 class="text-3xl font-bold text-white mb-8">
        Dashboard Overview
    </h1>

    <section aria-labelledby="statsHeading" class="mb-10">
        <h2 id="statsHeading" class="sr-only">Key figures</h2>

        <ul class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            {stats.map((stat) => (
                <li>
                    <a href={stat.href} class="glass-card hover-glow p-5 block h-full">
                        <span class="admin-label">{stat.label}</span>
                        <span id={stat.id} class="block text-3xl font-black text-white mt-2">…</span>
                    </a>
                </li>
            ))}
        </ul>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <section class="lg:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-6" aria-label="Sections">
            {sections.map((section) => (
                <a
                    href={section.href}
                    class="block p-6 glass-card hover-glow group relative overflow-hidden"
                >
                    <div class="absolute inset-0 bg-cyan-500/5 translate-y-[100%] group-hover:translate-y-0 transition-transform duration-300"></div>

                    <h2 class="text-xl font-bold text-white mb-2 relative z-10 tracking-tight group-hover:text-cyan-300 transition-colors">
                        {section.title}
                    </h2>

                    <p class="text-slate-300 text-sm relative z-10">
                        {section.text}
                    </p>
                </a>
            ))}
        </section>

        <section class="glass-card p-6" aria-labelledby="recentHeading">
            <h2 id="recentHeading" class="text-lg font-bold text-white mb-4">Recently updated</h2>
            <ul id="recentProjects">
                <li class="text-sm text-slate-400">Loading…</li>
            </ul>
        </section>
    </div>
</AdminLayout>

<script>
    import { whenAuthenticated } from '../../../lib/admin/boot';
    import { initOverview } from '../../../lib/admin/overview';

    void whenAuthenticated(() => initOverview());
</script>
