---
/**
 * @file frontend/src/pages/admin/dashboard/index.astro
 * @description Protected administrator dashboard overview.
 *
 * The dashboard verifies the real backend administrator session before
 * exposing protected content. The JWT remains HttpOnly and is never read
 * from client-side JavaScript.
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard | Admin">
    <h1 class="text-3xl font-bold text-white mb-8">
        Dashboard Overview
    </h1>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <a
            href="/admin/dashboard/projects"
            class="block p-6 glass-card hover-glow group relative overflow-hidden"
        >
            <div class="absolute inset-0 bg-cyan-500/5 translate-y-[100%] group-hover:translate-y-0 transition-transform duration-300"></div>

            <h2 class="text-xl font-bold text-white mb-2 relative z-10 tracking-tight group-hover:text-cyan-300 transition-colors">
                Projects
            </h2>

            <p class="text-slate-300 text-sm relative z-10">
                Manage portfolio projects and generate AI descriptions.
            </p>
        </a>

        <a
            href="/admin/dashboard/experiences"
            class="block p-6 glass-card hover-glow group relative overflow-hidden"
        >
            <div class="absolute inset-0 bg-cyan-500/5 translate-y-[100%] group-hover:translate-y-0 transition-transform duration-300"></div>

            <h2 class="text-xl font-bold text-white mb-2 relative z-10 tracking-tight group-hover:text-cyan-300 transition-colors">
                Experiences
            </h2>

            <p class="text-slate-300 text-sm relative z-10">
                Manage work history and roles.
            </p>
        </a>

        <a
            href="/admin/dashboard/api"
            class="block p-6 glass-card hover-glow group relative overflow-hidden"
        >
            <div class="absolute inset-0 bg-cyan-500/5 translate-y-[100%] group-hover:translate-y-0 transition-transform duration-300"></div>

            <h2 class="text-xl font-bold text-white mb-2 relative z-10 tracking-tight group-hover:text-cyan-300 transition-colors">
                API Playground
            </h2>

            <p class="text-slate-300 text-sm relative z-10">
                Test endpoints directly from the browser.
            </p>
        </a>

        <a
            href="/admin/dashboard/system"
            class="block p-6 glass-card hover-glow group relative overflow-hidden"
        >
            <div class="absolute inset-0 bg-cyan-500/5 translate-y-[100%] group-hover:translate-y-0 transition-transform duration-300"></div>

            <h2 class="text-xl font-bold text-white mb-2 relative z-10 tracking-tight group-hover:text-cyan-300 transition-colors">
                System Status
            </h2>

            <p class="text-slate-300 text-sm relative z-10">
                Check backend and database health.
            </p>
        </a>
    </div>
</AdminLayout>

<script>
    /**
     * Verify the HttpOnly JWT through the backend.
     *
     * The cookie itself cannot be read by JavaScript, but fetch with
     * credentials: include allows the browser to send it to the backend.
     */
    async function verifyAuth(): Promise<void> {
        try {
            const apiUrl =
                import.meta.env.PUBLIC_API_URL?.replace(
                    /\/$/,
                    '',
                ) ||
                'http://127.0.0.1:3002';

            const response =
                await fetch(
                    `${apiUrl}/api/auth/me`,
                    {
                        method: 'GET',
                        credentials:
                            'include',
                    },
                );

            if (
                !response.ok
            ) {
                window.location.replace(
                    '/admin/login',
                );
            }
        } catch {
            window.location.replace(
                '/admin/login',
            );
        }
    }

    void verifyAuth();
</script>