---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard | Admin">
    <h1 class="text-3xl font-bold text-white mb-8">Dashboard Overview</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Quick Links -->
        <a href="/admin/dashboard/projects" class="block p-6 bg-slate-900 border border-white/10 rounded-xl hover:border-blue-500/50 transition-colors group relative overflow-hidden">
            <div class="absolute inset-0 bg-blue-500/5 translate-y-[100%] group-hover:translate-y-0 transition-transform"></div>
            <h2 class="text-xl font-semibold text-white mb-2 relative z-10">Projects</h2>
            <p class="text-slate-400 text-sm relative z-10">Manage portfolio projects and generate AI descriptions.</p>
        </a>
        
        <a href="/admin/dashboard/experiences" class="block p-6 bg-slate-900 border border-white/10 rounded-xl hover:border-emerald-500/50 transition-colors group relative overflow-hidden">
            <div class="absolute inset-0 bg-emerald-500/5 translate-y-[100%] group-hover:translate-y-0 transition-transform"></div>
            <h2 class="text-xl font-semibold text-white mb-2 relative z-10">Experiences</h2>
            <p class="text-slate-400 text-sm relative z-10">Manage work history and roles.</p>
        </a>
        
        <a href="/admin/dashboard/api" class="block p-6 bg-slate-900 border border-white/10 rounded-xl hover:border-purple-500/50 transition-colors group relative overflow-hidden">
            <div class="absolute inset-0 bg-purple-500/5 translate-y-[100%] group-hover:translate-y-0 transition-transform"></div>
            <h2 class="text-xl font-semibold text-white mb-2 relative z-10">API Playground</h2>
            <p class="text-slate-400 text-sm relative z-10">Test endpoints directly from the browser.</p>
        </a>

        <a href="/admin/dashboard/system" class="block p-6 bg-slate-900 border border-white/10 rounded-xl hover:border-orange-500/50 transition-colors group relative overflow-hidden">
            <div class="absolute inset-0 bg-orange-500/5 translate-y-[100%] group-hover:translate-y-0 transition-transform"></div>
            <h2 class="text-xl font-semibold text-white mb-2 relative z-10">System Status</h2>
            <p class="text-slate-400 text-sm relative z-10">Check backend and database health.</p>
        </a>
    </div>
</AdminLayout>

<script>
    // Simple client-side auth check
    // In a real production scenario, Astro SSR or middleware would handle this better
    // But since the API sets an HttpOnly cookie, we can't read it via JS.
    // The real source of truth is the backend. We'll do a quick fetch to test auth.
    async function verifyAuth() {
        try {
            // Using a safe GET endpoint that requires auth, or simply just relying on API calls failing later.
            // For now, if the user doesn't have the cookie, their API calls will just 401.
        } catch (e) {
            console.error(e);
        }
    }
    
    verifyAuth();
</script>
