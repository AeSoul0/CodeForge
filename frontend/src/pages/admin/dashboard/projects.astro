---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Projects | Admin">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-white">Projects</h1>
        <button id="newProjectBtn" class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded font-medium transition-colors">
            + New Project
        </button>
    </div>
    
    <div class="bg-slate-900 border border-white/10 rounded-xl overflow-hidden">
        <table class="w-full text-left text-sm text-slate-400">
            <thead class="text-xs text-slate-300 uppercase bg-black/30 border-b border-white/10">
                <tr>
                    <th scope="col" class="px-6 py-4 font-medium">Project</th>
                    <th scope="col" class="px-6 py-4 font-medium">Category</th>
                    <th scope="col" class="px-6 py-4 font-medium">Technologies</th>
                    <th scope="col" class="px-6 py-4 font-medium text-right">Actions</th>
                </tr>
            </thead>
            <tbody id="projectsTableBody">
                <tr>
                    <td colspan="4" class="px-6 py-4 text-center">Loading projects...</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Modal for Create/Edit -->
    <div id="projectModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle" class="fixed inset-0 bg-black/80 z-[100] hidden flex items-center justify-center p-4 backdrop-blur-sm overflow-y-auto">
        <div class="bg-slate-900 border border-white/10 rounded-xl w-full max-w-2xl my-8">
            <div class="flex justify-between items-center p-6 border-b border-white/10">
                <h2 id="modalTitle" class="text-xl font-bold text-white">New Project</h2>
                <button id="closeModalBtn" aria-label="Close Modal" class="text-slate-400 hover:text-white">&times;</button>
            </div>
            
            <form id="projectForm" class="p-6 space-y-4">
                <input type="hidden" id="projectId" />
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-1">Title</label>
                        <input type="text" id="p-titolo" required class="w-full bg-black/50 border border-white/10 rounded px-3 py-2 text-white">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-1">Role</label>
                        <input type="text" id="p-role" class="w-full bg-black/50 border border-white/10 rounded px-3 py-2 text-white">
                    </div>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1">Description</label>
                    <textarea id="p-descrizione" required rows="3" class="w-full bg-black/50 border border-white/10 rounded px-3 py-2 text-white"></textarea>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1">Long Description</label>
                    <textarea id="p-descrizioneLunga" rows="5" class="w-full bg-black/50 border border-white/10 rounded px-3 py-2 text-white"></textarea>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-1">Category</label>
                        <input type="text" id="p-categoria" class="w-full bg-black/50 border border-white/10 rounded px-3 py-2 text-white">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-1">Technologies (comma separated)</label>
                        <input type="text" id="p-tecnologie" required class="w-full bg-black/50 border border-white/10 rounded px-3 py-2 text-white">
                    </div>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1">GitHub URL</label>
                    <input type="url" id="p-linkGithub" class="w-full bg-black/50 border border-white/10 rounded px-3 py-2 text-white">
                </div>

                <div id="modalError" class="text-red-400 text-sm hidden"></div>
                
                <div class="flex justify-end gap-3 pt-4 border-t border-white/10">
                    <button type="button" id="cancelBtn" class="px-4 py-2 rounded text-slate-300 hover:bg-white/5 transition-colors">Cancel</button>
                    <button type="submit" id="saveBtn" class="bg-blue-600 hover:bg-blue-500 text-white px-6 py-2 rounded font-medium transition-colors">Save</button>
                    <button type="button" id="aiBtn" class="hidden bg-purple-600 hover:bg-purple-500 text-white px-4 py-2 rounded font-medium transition-colors">Generate AI Description</button>
                </div>
            </form>
        </div>
    </div>
</AdminLayout>

<script>
    const baseUrl = 'http://localhost:3002'; // Change in production
    
    const tableBody = document.getElementById('projectsTableBody');
    const modal = document.getElementById('projectModal');
    const projectForm = document.getElementById('projectForm') as HTMLFormElement;
    let projectsData: any[] = [];
    
    async function loadProjects() {
        try {
            const res = await fetch(`${baseUrl}/api/projects?limit=50`);
            const json = await res.json();
            projectsData = json.data || [];
            renderTable();
        } catch (e) {
            tableBody!.innerHTML = `<tr><td colspan="4" class="px-6 py-4 text-center text-red-400">Failed to load projects</td></tr>`;
        }
    }
    
    function renderTable() {
        if (!projectsData.length) {
            tableBody!.innerHTML = `<tr><td colspan="4" class="px-6 py-4 text-center">No projects found</td></tr>`;
            return;
        }
        
        tableBody!.innerHTML = projectsData.map(p => `
            <tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
                <td class="px-6 py-4 font-medium text-white">${p.titolo}</td>
                <td class="px-6 py-4">${p.categoria || '-'}</td>
                <td class="px-6 py-4">${(p.tecnologie || []).join(', ')}</td>
                <td class="px-6 py-4 text-right">
                    <button class="text-blue-400 hover:text-blue-300 mr-3 edit-btn" data-id="${p._id}">Edit</button>
                    <button class="text-red-400 hover:text-red-300 delete-btn" data-id="${p._id}">Delete</button>
                </td>
            </tr>
        `).join('');
        
        document.querySelectorAll('.edit-btn').forEach(btn => btn.addEventListener('click', (e) => {
            const id = (e.target as HTMLButtonElement).dataset.id;
            const project = projectsData.find(x => x._id === id);
            if(project) openModal(project);
        }));
        
        document.querySelectorAll('.delete-btn').forEach(btn => btn.addEventListener('click', async (e) => {
            const id = (e.target as HTMLButtonElement).dataset.id;
            if(confirm('Are you sure you want to delete this project?')) {
                try {
                    await fetch(`${baseUrl}/api/projects/${id}`, { method: 'DELETE' });
                    loadProjects();
                } catch(err) {
                    alert('Error deleting project');
                }
            }
        }));
    }
    
    function openModal(project: any = null) {
        projectForm.reset();
        document.getElementById('modalError')!.classList.add('hidden');
        const aiBtn = document.getElementById('aiBtn')!;
        
        if (project) {
            document.getElementById('modalTitle')!.textContent = 'Edit Project';
            (document.getElementById('projectId') as HTMLInputElement).value = project._id;
            (document.getElementById('p-titolo') as HTMLInputElement).value = project.titolo || '';
            (document.getElementById('p-role') as HTMLInputElement).value = project.role || '';
            (document.getElementById('p-descrizione') as HTMLInputElement).value = project.descrizione || '';
            (document.getElementById('p-descrizioneLunga') as HTMLInputElement).value = project.descrizioneLunga || '';
            (document.getElementById('p-categoria') as HTMLInputElement).value = project.categoria || '';
            (document.getElementById('p-tecnologie') as HTMLInputElement).value = (project.tecnologie || []).join(', ');
            (document.getElementById('p-linkGithub') as HTMLInputElement).value = project.linkGithub || '';
            
            aiBtn.classList.remove('hidden');
            aiBtn.onclick = async () => {
                aiBtn.textContent = 'Generating...';
                try {
                    await fetch(`${baseUrl}/api/projects/${project._id}/generate-ai`, { method: 'POST' });
                    alert('AI Generation triggered!');
                    loadProjects();
                    modal!.classList.add('hidden');
                } catch(e) {
                    alert('Error generating AI text');
                } finally {
                    aiBtn.textContent = 'Generate AI Description';
                }
            };
        } else {
            document.getElementById('modalTitle')!.textContent = 'New Project';
            (document.getElementById('projectId') as HTMLInputElement).value = '';
            aiBtn.classList.add('hidden');
        }
        
        modal!.classList.remove('hidden');
    }
    
    document.getElementById('newProjectBtn')?.addEventListener('click', () => openModal());
    document.getElementById('closeModalBtn')?.addEventListener('click', () => modal!.classList.add('hidden'));
    document.getElementById('cancelBtn')?.addEventListener('click', () => modal!.classList.add('hidden'));
    
    projectForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const id = (document.getElementById('projectId') as HTMLInputElement).value;
        const payload = {
            titolo: (document.getElementById('p-titolo') as HTMLInputElement).value,
            role: (document.getElementById('p-role') as HTMLInputElement).value,
            descrizione: (document.getElementById('p-descrizione') as HTMLInputElement).value,
            descrizioneLunga: (document.getElementById('p-descrizioneLunga') as HTMLInputElement).value,
            categoria: (document.getElementById('p-categoria') as HTMLInputElement).value,
            tecnologie: (document.getElementById('p-tecnologie') as HTMLInputElement).value.split(',').map(s=>s.trim()).filter(Boolean),
            linkGithub: (document.getElementById('p-linkGithub') as HTMLInputElement).value || null
        };
        
        const method = id ? 'PATCH' : 'POST';
        const url = id ? `${baseUrl}/api/projects/${id}` : `${baseUrl}/api/projects`;
        
        try {
            const res = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const result = await res.json();
            
            if (result.success) {
                modal!.classList.add('hidden');
                loadProjects();
            } else {
                const err = document.getElementById('modalError')!;
                err.textContent = result.message || 'Error saving project';
                err.classList.remove('hidden');
            }
        } catch (err) {
            const errEl = document.getElementById('modalError')!;
            errEl.textContent = 'Network error.';
            errEl.classList.remove('hidden');
        }
    });

    loadProjects();
</script>
