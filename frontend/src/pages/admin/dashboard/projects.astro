---
/**
 * @file frontend/src/pages/admin/dashboard/projects.astro
 * @description Project management: list, search, create, edit, AI
 * regeneration and deletion. Behaviour lives in src/lib/admin/projects.ts.
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Projects | Admin">
    <div class="flex flex-wrap gap-4 justify-between items-center mb-6">
        <div>
            <h1 class="text-3xl font-black tracking-tight text-white">Projects</h1>
            <p id="projectCount" class="text-sm text-slate-400 mt-1" aria-live="polite"></p>
        </div>

        <div class="flex flex-wrap gap-3 items-center">
            <label for="projectSearch" class="sr-only">Search projects</label>
            <input
                id="projectSearch"
                type="search"
                placeholder="Search title, stack, category…"
                class="admin-field w-64"
                autocomplete="off"
            />
            <button id="newProjectBtn" type="button" class="admin-btn-primary">
                + New Project
            </button>
        </div>
    </div>

    <div class="glass-card overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
            <caption class="sr-only">Portfolio projects</caption>
            <thead class="text-xs text-slate-300 uppercase bg-black/30 border-b border-white/10">
                <tr>
                    <th scope="col" class="px-6 py-4 font-medium">Project</th>
                    <th scope="col" class="px-6 py-4 font-medium">Categories</th>
                    <th scope="col" class="px-6 py-4 font-medium hidden md:table-cell">Technologies</th>
                    <th scope="col" class="px-6 py-4 font-medium hidden lg:table-cell">Updated</th>
                    <th scope="col" class="px-6 py-4 font-medium text-right">Actions</th>
                </tr>
            </thead>
            <tbody id="projectsTableBody">
                <tr>
                    <td colspan="5" class="px-6 py-6 text-center text-slate-400">Loading projects…</td>
                </tr>
            </tbody>
        </table>
    </div>

    <dialog id="projectDialog" class="admin-dialog" aria-labelledby="projectDialogTitle">
        <form id="projectForm" class="glass-card relative overflow-hidden" novalidate>
            <div class="flex justify-between items-center p-6 border-b border-white/10">
                <h2 id="projectDialogTitle" class="text-xl font-bold text-white tracking-tight">New Project</h2>
                <button type="button" data-dialog-close aria-label="Close dialog" class="text-2xl leading-none text-slate-400 hover:text-white">&times;</button>
            </div>

            <div class="p-6 space-y-4 max-h-[65dvh] overflow-y-auto">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="p-titolo" class="admin-label">Title *</label>
                        <input id="p-titolo" type="text" required minlength="3" maxlength="100" class="admin-field" />
                    </div>
                    <div>
                        <label for="p-role" class="admin-label">Role</label>
                        <input id="p-role" type="text" maxlength="100" class="admin-field" />
                    </div>
                </div>

                <div>
                    <label for="p-descrizione" class="admin-label">Description *</label>
                    <textarea id="p-descrizione" required minlength="10" maxlength="5000" rows="3" class="admin-field"></textarea>
                </div>

                <div>
                    <label for="p-descrizioneLunga" class="admin-label">Long description (Markdown)</label>
                    <textarea id="p-descrizioneLunga" rows="6" maxlength="50000" class="admin-field font-mono text-xs" aria-describedby="p-descrizioneLunga-hint"></textarea>
                    <p id="p-descrizioneLunga-hint" class="text-xs text-slate-400 mt-1">Leave empty to let the AI generate it after saving.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="p-categorie" class="admin-label">Categories (comma separated)</label>
                        <input id="p-categorie" type="text" list="categorySuggestions" class="admin-field" placeholder="full-stack, ai" />
                        <datalist id="categorySuggestions">
                            <option value="full-stack"></option>
                            <option value="embedded"></option>
                            <option value="ai"></option>
                            <option value="iot"></option>
                            <option value="data"></option>
                        </datalist>
                    </div>
                    <div>
                        <label for="p-tecnologie" class="admin-label">Technologies * (comma separated)</label>
                        <input id="p-tecnologie" type="text" required class="admin-field" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="p-linkGithub" class="admin-label">GitHub URL</label>
                        <input id="p-linkGithub" type="url" maxlength="500" class="admin-field" placeholder="https://github.com/…" />
                    </div>
                    <div>
                        <label for="p-image" class="admin-label">Image URL</label>
                        <input id="p-image" type="text" maxlength="500" class="admin-field" />
                    </div>
                </div>

                <div>
                    <label for="p-experienceId" class="admin-label">Linked experience</label>
                    <select id="p-experienceId" class="admin-field">
                        <option value="">No linked experience</option>
                    </select>
                </div>

                <div id="projectFormError" role="alert" class="hidden text-red-300 text-sm bg-red-500/10 border border-red-500/20 p-3 rounded-lg"></div>
            </div>

            <div class="flex justify-end gap-3 p-6 border-t border-white/10">
                <button type="button" data-dialog-close class="admin-btn-ghost">Cancel</button>
                <button type="submit" id="projectSaveBtn" class="admin-btn-primary">Save</button>
            </div>
        </form>
    </dialog>
</AdminLayout>

<script>
    import { whenAuthenticated } from '../../../lib/admin/boot';
    import { initProjectsPage } from '../../../lib/admin/projects';

    void whenAuthenticated(() => initProjectsPage().reload());
</script>
