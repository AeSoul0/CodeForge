---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="System Status | Admin">
    <h1 class="text-3xl font-black tracking-tight text-white mb-8">System Status</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Status Overview -->
        <div class="glass-card p-6">
            <h2 class="text-xl font-bold text-white mb-6 tracking-tight">Overview</h2>
            
            <div class="space-y-4">
                <div class="flex justify-between items-center pb-4 border-b border-white/5">
                    <span class="text-slate-400 text-sm">Backend API</span>
                    <div class="flex items-center gap-2">
                        <div id="status-live" class="w-2 h-2 rounded-full bg-slate-500 shadow-[0_0_10px_rgba(100,116,139,0.8)]"></div>
                        <span id="text-live" class="text-xs font-semibold uppercase tracking-wider text-slate-300">Checking...</span>
                    </div>
                </div>
                
                <div class="flex justify-between items-center pb-4 border-b border-white/5">
                    <span class="text-slate-400 text-sm">Database & Services</span>
                    <div class="flex items-center gap-2">
                        <div id="status-ready" class="w-2 h-2 rounded-full bg-slate-500 shadow-[0_0_10px_rgba(100,116,139,0.8)]"></div>
                        <span id="text-ready" class="text-xs font-semibold uppercase tracking-wider text-slate-300">Checking...</span>
                    </div>
                </div>
                
                <div class="flex justify-between items-center">
                    <span class="text-slate-400 text-sm">Environment</span>
                    <span class="text-xs font-mono text-cyan-400 font-medium px-2 py-1 bg-cyan-400/10 rounded">Production</span>
                </div>
            </div>
            
            <div class="mt-8 pt-4 border-t border-white/10 flex justify-end">
                <button id="refreshBtn" class="bg-cyan-500/10 hover:bg-cyan-500/20 border border-cyan-500/30 text-cyan-400 px-4 py-2 rounded-full text-xs uppercase tracking-wider font-semibold transition-all shadow-[0_0_15px_rgba(34,211,238,0.1)]">
                    Refresh Status
                </button>
            </div>
        </div>
        
        <!-- Metrics (Optional) -->
        <div class="glass-card p-6">
            <h2 class="text-xl font-bold text-white mb-6 tracking-tight">Metrics</h2>
            <div id="metricsContent" class="text-slate-300 text-xs font-mono whitespace-pre-wrap overflow-auto h-64 bg-black/30 p-4 rounded-xl border border-white/5">
Loading metrics...
            </div>
        </div>
    </div>
</AdminLayout>

<script>
    const baseUrl = import.meta.env.PUBLIC_API_URL?.replace(/\/$/, "") || 'https://codeforge-ukq5.onrender.com';

    async function checkStatus() {
        const liveDot = document.getElementById('status-live');
        const liveText = document.getElementById('text-live');
        const readyDot = document.getElementById('status-ready');
        const readyText = document.getElementById('text-ready');
        const metricsContent = document.getElementById('metricsContent');
        const refreshBtn = document.getElementById('refreshBtn') as HTMLButtonElement;
        
        if(refreshBtn) {
            refreshBtn.disabled = true;
            refreshBtn.textContent = 'Refreshing...';
        }

        try {
            // Liveness
            const liveRes = await fetch(`${baseUrl}/live`);
            if (liveRes.ok) {
                liveDot!.className = 'w-2 h-2 rounded-full bg-green-500';
                liveText!.textContent = 'Online';
            } else {
                liveDot!.className = 'w-2 h-2 rounded-full bg-red-500';
                liveText!.textContent = 'Offline';
            }
            
            // Readiness
            const readyRes = await fetch(`${baseUrl}/ready`);
            if (readyRes.ok) {
                readyDot!.className = 'w-2 h-2 rounded-full bg-green-500';
                readyText!.textContent = 'Connected';
            } else {
                readyDot!.className = 'w-2 h-2 rounded-full bg-red-500';
                readyText!.textContent = 'Degraded';
            }
            
            // Metrics
            const metricsRes = await fetch(`${baseUrl}/metrics`);
            if (metricsRes.ok) {
                const metrics = await metricsRes.json();
                metricsContent!.textContent = JSON.stringify(metrics, null, 2);
            } else {
                metricsContent!.textContent = 'Failed to load metrics.';
            }

        } catch (e) {
            liveDot!.className = 'w-2 h-2 rounded-full bg-red-500';
            liveText!.textContent = 'Unreachable';
            readyDot!.className = 'w-2 h-2 rounded-full bg-red-500';
            readyText!.textContent = 'Unreachable';
            metricsContent!.textContent = 'Network error.';
        } finally {
            if(refreshBtn) {
                refreshBtn.disabled = false;
                refreshBtn.textContent = 'Refresh Status';
            }
        }
    }
    
    document.getElementById('refreshBtn')?.addEventListener('click', checkStatus);
    
    // Initial check
    checkStatus();
</script>
