---
/**
 * @file frontend/src/pages/admin/dashboard/system.astro
 * @description Backend health and runtime metrics.
 * Behaviour lives in src/lib/admin/system.ts.
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getApiUrl } from '../../../lib/api';

const apiHost = new URL(getApiUrl()).host;
const mode = import.meta.env.MODE;

const metricTiles = [
    { id: 'metric-requests', label: 'Requests served' },
    { id: 'metric-error-rate', label: '4xx + 5xx rate' },
    { id: 'metric-avg-latency', label: 'Avg server latency' },
    { id: 'metric-latency', label: 'Round-trip (probe)' },
];

const statusBuckets = ['2xx', '3xx', '4xx', '5xx'];
---

<AdminLayout title="System Status | Admin">
    <div class="flex flex-wrap gap-4 justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-black tracking-tight text-white">System Status</h1>
            <p id="lastChecked" class="text-sm text-slate-400 mt-1" aria-live="polite">Checking…</p>
        </div>

        <div class="flex items-center gap-4">
            <label class="flex items-center gap-2 text-sm text-slate-300">
                <input id="autoRefresh" type="checkbox" class="w-4 h-4" />
                Auto-refresh (30 s)
            </label>
            <button id="refreshBtn" type="button" class="admin-btn-primary">Refresh</button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <section class="glass-card p-6" aria-labelledby="overviewHeading">
            <h2 id="overviewHeading" class="text-xl font-bold text-white mb-6 tracking-tight">Overview</h2>

            <dl class="space-y-4">
                <div class="flex justify-between items-center pb-4 border-b border-white/5">
                    <dt class="text-slate-400 text-sm">Backend API</dt>
                    <dd class="flex items-center gap-2">
                        <span id="status-live" class="w-2.5 h-2.5 rounded-full bg-slate-500" aria-hidden="true"></span>
                        <span id="text-live" class="text-xs font-semibold uppercase tracking-wider text-slate-300">Checking...</span>
                    </dd>
                </div>

                <div class="flex justify-between items-center pb-4 border-b border-white/5">
                    <dt class="text-slate-400 text-sm">Database</dt>
                    <dd class="flex items-center gap-2">
                        <span id="status-ready" class="w-2.5 h-2.5 rounded-full bg-slate-500" aria-hidden="true"></span>
                        <span id="text-ready" class="text-xs font-semibold uppercase tracking-wider text-slate-300">Checking...</span>
                    </dd>
                </div>

                <div class="flex justify-between items-center pb-4 border-b border-white/5">
                    <dt class="text-slate-400 text-sm">API host</dt>
                    <dd class="text-xs font-mono text-cyan-300">{apiHost}</dd>
                </div>

                <div class="flex justify-between items-center">
                    <dt class="text-slate-400 text-sm">Frontend mode</dt>
                    <dd class="text-xs font-mono text-cyan-300 px-2 py-1 bg-cyan-400/10 rounded">{mode}</dd>
                </div>
            </dl>
        </section>

        <section class="glass-card p-6" aria-labelledby="metricsHeading">
            <h2 id="metricsHeading" class="text-xl font-bold text-white mb-6 tracking-tight">Metrics</h2>

            <dl class="grid grid-cols-2 gap-4 mb-6">
                {metricTiles.map((tile) => (
                    <div class="rounded-xl bg-black/30 border border-white/5 p-4">
                        <dt class="admin-label">{tile.label}</dt>
                        <dd id={tile.id} class="text-2xl font-black text-white mt-1">—</dd>
                    </div>
                ))}
            </dl>

            <dl class="grid grid-cols-4 gap-2 text-center">
                {statusBuckets.map((bucket) => (
                    <div class="rounded-lg bg-black/20 p-2">
                        <dt class="text-[10px] uppercase text-slate-400">{bucket}</dt>
                        <dd id={`metric-${bucket}`} class="font-mono text-sm text-white">—</dd>
                    </div>
                ))}
            </dl>
        </section>
    </div>

    <details class="glass-card p-6">
        <summary class="cursor-pointer text-sm font-semibold text-slate-300">Raw metrics JSON</summary>
        <pre id="metricsRaw" class="mt-4 text-slate-300 text-xs font-mono whitespace-pre-wrap overflow-auto max-h-64 bg-black/30 p-4 rounded-xl border border-white/5">Loading metrics...</pre>
    </details>
</AdminLayout>

<script>
    import { whenAuthenticated } from '../../../lib/admin/boot';
    import { initSystemPage } from '../../../lib/admin/system';

    void whenAuthenticated(() => initSystemPage().refresh());
</script>
