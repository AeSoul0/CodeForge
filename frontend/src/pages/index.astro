---
/**
 * @file src/pages/index.astro
 * @description Main homepage entry point.
 *
 * Handles server-side API fetching and composes the main
 * visual sections inside the global layout.
 *
 * Projects and experiences are retrieved from the backend API
 * rather than accessing MongoDB directly from the frontend.
 */

import Layout from "../layout/Layout.astro";
import Navbar from "../components/Navbar.astro";
import ParticleCanvas from "../components/ParticleCanvas.astro";
import HeroBento from "../components/HeroBento.astro";
import CoreCompetencies from "../components/CoreCompetencies.astro";
import ProjectsGrid from "../components/ProjectsGrid.astro";
import Experience from "../components/Experience.astro";
import Footer from "../components/Footer.astro";

import "../styles/global.css";

/**
 * Frontend representation of a project returned by the API.
 */
interface Project {
	_id: string;
	titolo: string;
	descrizione: string;
	tecnologie: string[];
	categorie: string[];
	linkGithub?: string;
}

/**
 * Frontend representation of an experience returned by the API.
 *
 * Dates remain ISO-compatible strings because the data is received
 * through the HTTP API and formatted by the Experience component.
 *
 * image is optional because not every experience necessarily needs
 * an associated organization logo.
 */
interface ExperienceItem {
	_id: string;
	role: string;
	company: string;
	description: string;
	technologies: string[];
	startDate: string;
	endDate?: string | null;
	current: boolean;
	image?: string | null;
}

let projects: Project[] = [];
let experiences: ExperienceItem[] = [];

/**
 * Backend API base URL.
 *
 * PUBLIC_API_URL is used in production, while localhost:3002
 * remains the default for local development.
 */
const apiUrl =
	import.meta.env.PUBLIC_API_URL?.replace(/\/$/, "") ||
	"https://codeforge-ukq5.onrender.com";

// ======================================================
// PROJECTS
// ======================================================

/**
 * Fetch project data from the backend.
 *
 * The backend is responsible for querying MongoDB and sorting
 * project records before returning them to the frontend.
 */
try {
	const response = await fetch(`${apiUrl}/api/projects`);

	if (!response.ok) {
		throw new Error(
			`Projects API request failed with status ${response.status}`,
		);
	}

	const responseBody: any = await response.json();

	/**
	 * Validate the top-level API response before assigning it
	 * to the strongly typed projects collection.
	 * The backend wraps the response in { success: true, data: [...] }
	 */
	if (responseBody && Array.isArray(responseBody.data)) {
		projects = responseBody.data as Project[];
	} else if (Array.isArray(responseBody)) {
		projects = responseBody as Project[];
	} else {
		console.warn("[API Warning] Expected an array of projects.");
	}
} catch (error) {
	/**
	 * Keep the page renderable even when the backend is unavailable.
	 */
	console.error(
		"[Backend Connection Error] Failed to fetch projects:",
		error,
	);
}

// ======================================================
// EXPERIENCES
// ======================================================

/**
 * Fetch experience data from the backend.
 *
 * The backend queries MongoDB and returns experiences ordered
 * by startDate from newest to oldest.
 */
try {
	const response = await fetch(`${apiUrl}/api/experiences`);

	if (!response.ok) {
		throw new Error(
			`Experiences API request failed with status ${response.status}`,
		);
	}

	const responseBody: any = await response.json();

	/**
	 * Validate the API response before passing the records
	 * to the Experience component.
	 * The backend wraps the response in { success: true, data: [...] }
	 */
	if (responseBody && Array.isArray(responseBody.data)) {
		experiences = responseBody.data as ExperienceItem[];
	} else if (Array.isArray(responseBody)) {
		experiences = responseBody as ExperienceItem[];
	} else {
		console.warn("[API Warning] Expected an array of experiences.");
	}
} catch (error) {
	/**
	 * The rest of the homepage remains available even if
	 * the experience endpoint cannot be reached.
	 */
	console.error(
		"[Backend Connection Error] Failed to fetch experiences:",
		error,
	);
}
---

<Layout title="CodeForge | ÆSoul">
	<!-- ======================================================
         BACKGROUND / INTERACTIVE CANVAS
         ====================================================== -->

	<ParticleCanvas />

	<!-- ======================================================
         NAVIGATION
         ====================================================== -->

	<Navbar />

	<!-- ======================================================
         MAIN CONTENT
         ====================================================== -->

	<section
		class="max-w-6xl mx-auto px-6 py-4 flex-grow relative z-10 pointer-events-auto w-full"
		aria-label="Homepage content"
	>
		<!-- ======================================================
             HERO
             ====================================================== -->

		<HeroBento />

		<div class="section-divider" aria-hidden="true"></div>

		<!-- ======================================================
             RECENT PROJECTS
             ====================================================== -->

		<ProjectsGrid projects={projects} />

		<div class="section-divider" aria-hidden="true"></div>

		<!-- ======================================================
             PROFESSIONAL / ACADEMIC EXPERIENCE
             ====================================================== -->

		<Experience experiences={experiences} />

		<div class="section-divider" aria-hidden="true"></div>

		<!-- ======================================================
             CORE COMPETENCIES
             ====================================================== -->

		<CoreCompetencies />

		<div class="section-divider" aria-hidden="true"></div>
	</section>

	<!-- ======================================================
         FOOTER
         ====================================================== -->

	<Footer />
</Layout>
