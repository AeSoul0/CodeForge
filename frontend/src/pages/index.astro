---
/**
 * @file src/pages/index.astro
 * @description Main homepage entry point.
 *
 * Handles server-side API fetching and composes the main
 * visual sections inside the global layout.
 */

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import HeroBento from "../components/HeroBento.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import WhatIBring from "../components/WhatIBring.astro";
import CoreCompetencies from "../components/CoreCompetencies.astro";
import ProjectsGrid from "../components/ProjectsGrid.astro";
import Experience from "../components/Experience.astro";
import TechnicalProof from "../components/TechnicalProof.astro";
import Footer from "../components/Footer.astro";

import "../styles/global.css";

import { getApiUrl } from "../lib/api";
import { loadPortfolioContent } from "../lib/content";
import type { Project } from "../components/ProjectsGrid.astro";
import type { ExperienceItem } from "../components/Experience.astro";

/**
 * Cache the SSR-generated homepage at the Vercel edge.
 *
 * 60 seconds:
 *   fresh cache lifetime.
 *
 * 300 seconds:
 *   stale-while-revalidate window.
 *
 * This avoids re-running the homepage SSR/API requests for
 * every public request while keeping content reasonably fresh.
 */
Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=60, stale-while-revalidate=300",
);

const { projects, experiences, apiError } = await loadPortfolioContent<
	Project,
	ExperienceItem
>(getApiUrl());
---

<Layout title="CodeForge | ÆSoul">
	<Navbar slot="header" />

	<section
		class="max-w-6xl mx-auto px-6 py-4 flex-grow relative z-10 pointer-events-auto w-full"
		aria-label="Homepage content"
	>
		<HeroBento />

		<div class="section-divider" aria-hidden="true"></div>

		<div class="reveal-up"><FeaturedProject /></div>

		<div class="section-divider" aria-hidden="true"></div>

		<div class="reveal-up"><WhatIBring /></div>

		<div class="section-divider" aria-hidden="true"></div>

		<div class="reveal-up"><ProjectsGrid projects={projects} apiError={apiError} /></div>

		<div class="section-divider" aria-hidden="true"></div>

		<div class="reveal-up"><Experience experiences={experiences} apiError={apiError} /></div>

		<div class="section-divider" aria-hidden="true"></div>

		<div class="reveal-up"><CoreCompetencies /></div>

		<div class="section-divider" aria-hidden="true"></div>

		<div class="reveal-up"><TechnicalProof /></div>

		<div class="section-divider" aria-hidden="true"></div>
	</section>

	<Footer slot="footer" />
</Layout>