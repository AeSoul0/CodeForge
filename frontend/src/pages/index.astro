---
/**
 * @file src/pages/index.astro
 * @description Main homepage entry point.
 *
 * Handles server-side API fetching and composes the main
 * visual sections inside the global layout.
 */

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import ParticleCanvas from "../components/ParticleCanvas.astro";
import HeroBento from "../components/HeroBento.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import WhatIBring from "../components/WhatIBring.astro";
import CoreCompetencies from "../components/CoreCompetencies.astro";
import ProjectsGrid from "../components/ProjectsGrid.astro";
import Experience from "../components/Experience.astro";
import TechnicalProof from "../components/TechnicalProof.astro";
import Footer from "../components/Footer.astro";

import "../styles/global.css";

interface Project {
	_id: string;
	titolo: string;
	descrizione: string;
	tecnologie: string[];
	categorie: string[];
	linkGithub?: string;
}

interface ExperienceItem {
	_id: string;
	role: string;
	company: string;
	description: string;
	technologies: string[];
	startDate: string;
	endDate?: string | null;
	current: boolean;
	image?: string | null;
}

let projects: Project[] = [];
let experiences: ExperienceItem[] = [];
let apiError = false;

const apiUrl =
	import.meta.env.PUBLIC_API_URL?.replace(/\/$/, "") ||
	"https://codeforge-ukq5.onrender.com";

/**
 * Cache the SSR-generated homepage at the Vercel edge.
 *
 * 60 seconds:
 *   fresh cache lifetime.
 *
 * 300 seconds:
 *   stale-while-revalidate window.
 *
 * This avoids re-running the homepage SSR/API requests for
 * every public request while keeping content reasonably fresh.
 */
Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=60, stale-while-revalidate=300",
);

/**
 * Fetch projects and experiences in parallel.
 */
try {
	const [projectsResponse, experiencesResponse] = await Promise.all([
		fetch(`${apiUrl}/api/projects`),
		fetch(`${apiUrl}/api/experiences`),
	]);

	if (!projectsResponse.ok) {
		throw new Error(
			`Projects API request failed with status ${projectsResponse.status}`,
		);
	}

	if (!experiencesResponse.ok) {
		throw new Error(
			`Experiences API request failed with status ${experiencesResponse.status}`,
		);
	}

	const [projectsBody, experiencesBody]: [any, any] = await Promise.all([
		projectsResponse.json(),
		experiencesResponse.json(),
	]);

	if (projectsBody && Array.isArray(projectsBody.data)) {
		projects = projectsBody.data as Project[];
	} else if (Array.isArray(projectsBody)) {
		projects = projectsBody as Project[];
	} else {
		console.warn("[API Warning] Expected an array of projects.");
	}

	if (experiencesBody && Array.isArray(experiencesBody.data)) {
		experiences = experiencesBody.data as ExperienceItem[];
	} else if (Array.isArray(experiencesBody)) {
		experiences = experiencesBody as ExperienceItem[];
	} else {
		console.warn("[API Warning] Expected an array of experiences.");
	}
} catch (error) {
	apiError = true;

	console.error(
		"[Backend Connection Error] Failed to fetch homepage data:",
		error,
	);
}
---

<Layout title="CodeForge | ÆSoul">
	<ParticleCanvas />

	<Navbar />

	<section
		class="max-w-6xl mx-auto px-6 py-4 flex-grow relative z-10 pointer-events-auto w-full"
		aria-label="Homepage content"
	>
		<HeroBento />

		<div class="section-divider" aria-hidden="true"></div>

		<FeaturedProject />

		<div class="section-divider" aria-hidden="true"></div>

		<WhatIBring />

		<div class="section-divider" aria-hidden="true"></div>

		<ProjectsGrid projects={projects} apiError={apiError} />

		<div class="section-divider" aria-hidden="true"></div>

		<Experience experiences={experiences} apiError={apiError} />

		<div class="section-divider" aria-hidden="true"></div>

		<CoreCompetencies />

		<div class="section-divider" aria-hidden="true"></div>

		<TechnicalProof />

		<div class="section-divider" aria-hidden="true"></div>
	</section>

	<Footer />
</Layout>