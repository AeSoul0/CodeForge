---
/**
 * @file src/pages/index.astro
 * @description Main homepage entry point. Handles server-side project fetching
 * and composes the main visual sections inside the global layout.
 */

import Layout from "../layout/Layout.astro";
import Navbar from "../components/Navbar.astro";
import ParticleCanvas from "../components/ParticleCanvas.astro";
import HeroBento from "../components/HeroBento.astro";
import CoreCompetencies from "../components/CoreCompetencies.astro";
import ProjectsGrid from "../components/ProjectsGrid.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Project {
	_id: string;
	titolo: string;
	descrizione: string;
	tecnologie: string[];
	linkGithub?: string;
	categoria: string;
}

let projects: Project[] = [];

const apiUrl =
	import.meta.env.PUBLIC_API_URL?.replace(/\/$/, "") ||
	"http://localhost:3002";

try {
	const response = await fetch(`${apiUrl}/api/projects`);

	if (!response.ok) {
		throw new Error(`API request failed with status ${response.status}`);
	}

	const data: unknown = await response.json();

	if (Array.isArray(data)) {
		projects = data as Project[];
	} else {
		console.warn(
			"[API Warning] Unexpected response format: expected an array of projects.",
		);
	}
} catch (error) {
	console.error(
		"[Backend Connection Error] Failed to fetch projects:",
		error,
	);
}
---

<Layout title="CodeForge | ÆSoul">
	<!-- ======================================================
	     BACKGROUND / INTERACTIVE CANVAS
	     ====================================================== -->

	<ParticleCanvas />

	<!-- ======================================================
	     NAVIGATION
	     ====================================================== -->

	<Navbar />

	<!-- ======================================================
	     MAIN CONTENT
	     ====================================================== -->

	<section
		class="max-w-6xl mx-auto px-6 py-4 flex-grow relative z-10 pointer-events-auto w-full"
		aria-label="Homepage content"
	>
		<!-- ======================================================
		     HERO
		     ====================================================== -->

		<HeroBento />

		<!-- ======================================================
		     CORE COMPETENCIES
		     ====================================================== -->

		<div class="section-divider" aria-hidden="true"></div>

		<CoreCompetencies />

		<!-- ======================================================
		     RECENT PROJECTS
		     ====================================================== -->

		<div class="section-divider" aria-hidden="true"></div>

		<ProjectsGrid projects={projects} />

		<!-- ======================================================
		     BOTTOM DIVIDER
		     ====================================================== -->

		<div class="section-divider" aria-hidden="true"></div>
	</section>

	<!-- ======================================================
	     FOOTER
	     ====================================================== -->

	<Footer />
</Layout>
