---
/**
 * @file frontend/src/pages/projects/[id].astro
 * @description Dedicated project deep-dive page dynamically generated at build time.
 * Utilizes Astro's getStaticPaths to fetch project data from the backend and
 * construct static, highly performant dedicated pages for each project.
 */

import Layout from '../../layouts/Layout.astro';
import type { Project } from '../../components/ProjectsGrid.astro';

export async function getStaticPaths() {
	const apiUrl = import.meta.env.PUBLIC_API_URL?.replace(/\/$/, "") || "http://localhost:3002";
	let projects: Project[] = [];
	
	try {
		const response = await fetch(`${apiUrl}/api/projects`);
		if (response.ok) {
			const data = await response.json();
			if (data && Array.isArray(data.data)) {
				projects = data.data;
			} else if (Array.isArray(data)) {
				projects = data;
			}
		}
	} catch (e) {
		console.error("Failed to fetch projects for static paths", e);
	}

	return projects.map((project) => ({
		params: { id: project._id || project.id },
		props: { project },
	}));
}

interface Props {
	project: Project & { id?: string; descrizioneLunga?: string };
}

const { project } = Astro.props;
const categories = Array.isArray(project.categorie) && project.categorie.length > 0 
	? project.categorie 
	: (project.categoria ? [project.categoria] : ['Other']);

---

<Layout title={`${project.titolo} | CodeForge`}>
	<main class="pt-32 pb-20 min-h-screen px-6 max-w-5xl mx-auto">
		<div class="mb-10">
			<a href="/#projects&experiences" class="text-white/60 hover:text-white transition-colors flex items-center gap-2 mb-8 w-fit group">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform"><path d="m15 18-6-6 6-6"/></svg>
				Back to Projects
			</a>
			
			<div class="flex flex-wrap items-center gap-3 mb-4">
				{categories.map((cat) => (
					<span class="px-3 py-1 text-xs font-semibold uppercase tracking-wider bg-white/10 text-white rounded-full border border-white/5">
						{cat}
					</span>
				))}
			</div>

			<h1 class="text-5xl md:text-6xl font-bold text-white mb-6 tracking-tight leading-tight">
				{project.titolo}
			</h1>

			{project.linkGithub && (
				<a href={project.linkGithub} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-white text-black px-6 py-3 rounded-full font-medium hover:bg-white/90 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.02c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A4.8 4.8 0 0 0 8 18v4"/><path d="M12 18v-4"/></svg>
					View on GitHub
				</a>
			)}
		</div>

		{project.image ? (
			<div class="w-full aspect-video rounded-3xl overflow-hidden mb-16 border border-white/10 shadow-2xl relative">
				<img src={project.image} alt={project.titolo} class="w-full h-full object-cover" />
				<div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
			</div>
		) : (
			<div class="w-full aspect-video rounded-3xl overflow-hidden mb-16 border border-white/10 shadow-2xl relative bg-zinc-900 flex flex-col items-center justify-center">
				<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-white/20 mb-4"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
				<span class="text-white/40 font-medium">Screenshot coming soon</span>
			</div>
		)}

		<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
			<div class="md:col-span-2 prose prose-invert prose-lg max-w-none">
				<h2 class="text-2xl font-bold text-white mb-6">Overview</h2>
				<p class="text-white/70 leading-relaxed mb-10 text-xl font-light">
					{project.descrizione}
				</p>
				
				<h2 class="text-2xl font-bold text-white mb-6 mt-12">Deep Dive</h2>
				<div class="text-white/70 leading-relaxed space-y-6">
					{project.descrizioneLunga ? (
						<div set:html={project.descrizioneLunga.replace(/\n/g, '<br/>')} />
					) : (
						<p class="italic text-white/40">AI-generated detailed description is currently being processed and will be available soon.</p>
					)}
				</div>
			</div>
			
			<div>
				<div class="bg-white/[0.03] border border-white/[0.08] rounded-3xl p-8 sticky top-32">
					<h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/50"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
						Technologies
					</h3>
					<div class="flex flex-wrap gap-2">
						{project.tecnologie.map((tech) => (
							<span class="px-4 py-2 bg-white/5 text-white/80 rounded-xl text-sm font-medium border border-white/5 hover:bg-white/10 hover:text-white transition-colors">
								{tech}
							</span>
						))}
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>
