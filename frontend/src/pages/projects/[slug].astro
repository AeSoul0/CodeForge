---
/**
 * @file frontend/src/pages/projects/[slug].astro
 * @description Dedicated project deep-dive page dynamically generated at build time.
 */

import Layout from '../../layout/Layout.astro';
import ParticleCanvas from '../../components/ParticleCanvas.astro';
import type { Project } from '../../components/ProjectsGrid.astro';

export async function getStaticPaths() {
	const apiUrl = import.meta.env.PUBLIC_API_URL?.replace(/\/$/, "") || "http://localhost:3002";
	let projects: Project[] = [];
	
	try {
		const response = await fetch(`${apiUrl}/api/projects`);
		if (response.ok) {
			const data = await response.json();
			if (data && Array.isArray(data.data)) {
				projects = data.data;
			} else if (Array.isArray(data)) {
				projects = data;
			}
		}
	} catch (e) {
		console.error("Failed to fetch projects for static paths", e);
	}

	return projects.map((project) => {
		const slug = project.titolo.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
		return {
			params: { slug },
			props: { project },
		};
	});
}

interface Props {
	project: Project & { id?: string; descrizioneLunga?: string };
}

const { project } = Astro.props;
const categories = Array.isArray(project.categorie) && project.categorie.length > 0 
	? project.categorie 
	: (project.categoria ? [project.categoria] : ['Other']);

const displayImage = project.image || project.experienceImage;
---

<Layout title={`${project.titolo} | CodeForge`}>
	<ParticleCanvas />
	<div class="fixed top-0 left-0 w-full h-[500px] bg-gradient-to-b from-blue-900/10 via-transparent to-transparent pointer-events-none z-0 mix-blend-screen"></div>

	<main class="pt-32 pb-32 min-h-screen px-6 max-w-6xl mx-auto relative z-10 selection:bg-blue-500/30">
		<nav class="mb-12 animate-fade-in-up">
			<a href="/#projects&experiences" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/5 border border-white/10 text-white/70 hover:text-white hover:bg-white/10 hover:border-white/20 transition-all duration-300 font-medium text-sm group backdrop-blur-md">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform"><path d="m15 18-6-6 6-6"/></svg>
				Return to Portfolio
			</a>
		</nav>

		<header class="mb-20 animate-fade-in-up" style="animation-delay: 100ms;">
			<div class="flex flex-wrap items-center gap-3 mb-8">
				{categories.map((cat) => (
					<span class="px-4 py-1.5 text-[11px] font-black uppercase tracking-[0.2em] bg-white text-black rounded-full shadow-[0_0_15px_rgba(255,255,255,0.3)]">
						{cat}
					</span>
				))}
			</div>

			<h1 class="text-5xl md:text-8xl font-black text-transparent bg-clip-text bg-gradient-to-br from-white via-white/90 to-white/30 mb-8 tracking-tighter leading-[1.1]">
				{project.titolo}
			</h1>

			<p class="text-2xl md:text-3xl text-white/50 font-light leading-relaxed max-w-4xl tracking-tight">
				{project.descrizione}
			</p>
		</header>

		{displayImage && (
			<figure class="w-full aspect-[16/9] md:aspect-[21/9] rounded-[2rem] overflow-hidden mb-24 border border-white/10 shadow-[0_30px_100px_-20px_rgba(0,0,0,1)] relative animate-fade-in-up group" style="animation-delay: 200ms;">
				<img src={displayImage} alt={project.titolo} class="w-full h-full object-cover transform scale-100 group-hover:scale-[1.02] transition-transform duration-[1.5s] ease-[cubic-bezier(0.16,1,0.3,1)]" />
				<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent pointer-events-none"></div>
				
				{project.linkGithub && (
					<div class="absolute bottom-8 right-8 z-20">
						<a href={project.linkGithub} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 bg-white text-black px-6 py-4 rounded-full font-bold shadow-2xl hover:scale-105 transition-transform duration-300">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.02c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A4.8 4.8 0 0 0 8 18v4"/><path d="M12 18v-4"/></svg>
							Repository
						</a>
					</div>
				)}
			</figure>
		)}

		<div class="grid grid-cols-1 xl:grid-cols-12 gap-16 lg:gap-24 animate-fade-in-up" style="animation-delay: 300ms;">
			<div class="xl:col-span-8 prose prose-invert prose-lg md:prose-xl max-w-none prose-headings:font-black prose-headings:tracking-tight prose-headings:text-white prose-p:text-white/70 prose-p:leading-relaxed prose-a:text-white prose-a:underline-offset-4 prose-strong:text-white prose-code:text-white prose-code:bg-white/10 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-pre:bg-white/5 prose-pre:border prose-pre:border-white/10 prose-li:text-white/70">
				
				{!project.descrizioneLunga || project.descrizioneLunga.includes('AI analysis is currently processing') ? (
					<div class="bg-gradient-to-br from-white/5 to-transparent border border-white/10 rounded-[2rem] p-12 text-center backdrop-blur-md relative overflow-hidden">
						<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.05)_0%,transparent_70%)]"></div>
						<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-white/30 mb-6 animate-pulse"><path d="M12 2v4"/><path d="M12 18v4"/><path d="M4.93 4.93l2.83 2.83"/><path d="M16.24 16.24l2.83 2.83"/><path d="M2 12h4"/><path d="M18 12h4"/><path d="M4.93 19.07l2.83-2.83"/><path d="M16.24 7.76l2.83-2.83"/></svg>
						<h3 class="text-2xl font-bold text-white mb-3">Architectural Analysis Processing</h3>
						<p class="text-white/50 text-lg">Our AI is deeply analyzing the codebase and infrastructure pattern to generate a comprehensive technical report.</p>
					</div>
				) : (
					<div set:html={project.descrizioneLunga.replace(/\n/g, '<br/>')} />
				)}
			</div>
			
			<aside class="xl:col-span-4 relative">
				<div class="sticky top-32 flex flex-col gap-8">
					<div class="bg-white/5 border border-white/10 rounded-[2rem] p-8 backdrop-blur-xl">
						<h3 class="text-xs font-black text-white/40 mb-6 uppercase tracking-[0.2em]">Technology Stack</h3>
						<div class="flex flex-wrap gap-2">
							{project.tecnologie.map((tech) => (
								<span class="px-4 py-2 bg-black/40 border border-white/5 rounded-xl text-white/80 font-medium text-sm tracking-wide hover:bg-white/10 transition-colors cursor-default">
									{tech}
								</span>
							))}
						</div>
					</div>

					{!displayImage && project.linkGithub && (
						<a href={project.linkGithub} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-8 bg-white text-black rounded-[2rem] font-bold hover:scale-[1.02] transition-transform duration-300">
							<span class="text-lg">View Source Code</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						</a>
					)}
				</div>
			</aside>
		</div>
	</main>
</Layout>
