---
/**
 * @file frontend/src/pages/projects/[slug].astro
 * @description Dedicated project deep-dive page dynamically generated at build time.
 * Utilizes Astro's getStaticPaths to fetch project data from the backend and
 * construct static, highly performant dedicated pages for each project.
 */

import Layout from '../../layout/Layout.astro';
import ParticleCanvas from '../../components/ParticleCanvas.astro';
import type { Project } from '../../components/ProjectsGrid.astro';

export async function getStaticPaths() {
	const apiUrl = import.meta.env.PUBLIC_API_URL?.replace(/\/$/, "") || "http://localhost:3002";
	let projects: Project[] = [];
	
	try {
		const response = await fetch(`${apiUrl}/api/projects`);
		if (response.ok) {
			const data = await response.json();
			if (data && Array.isArray(data.data)) {
				projects = data.data;
			} else if (Array.isArray(data)) {
				projects = data;
			}
		}
	} catch (e) {
		console.error("Failed to fetch projects for static paths", e);
	}

	return projects.map((project) => {
		const slug = project.titolo.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
		return {
			params: { slug },
			props: { project },
		};
	});
}

interface Props {
	project: Project & { id?: string; descrizioneLunga?: string };
}

const { project } = Astro.props;
const categories = Array.isArray(project.categorie) && project.categorie.length > 0 
	? project.categorie 
	: (project.categoria ? [project.categoria] : ['Other']);

---

<Layout title={`${project.titolo} | CodeForge`}>
	<ParticleCanvas />
	<main class="pt-32 pb-20 min-h-screen px-6 max-w-5xl mx-auto relative z-10">
		<div class="mb-10 animate-fade-in-up">
			<a href="/#projects&experiences" class="text-white/50 hover:text-white transition-colors flex items-center gap-2 mb-8 w-fit group font-medium text-sm backdrop-blur-md bg-white/5 px-4 py-2 rounded-full border border-white/5 hover:border-white/20">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform"><path d="m15 18-6-6 6-6"/></svg>
				Return to Portfolio
			</a>
			
			<div class="flex flex-wrap items-center gap-3 mb-6">
				{categories.map((cat) => (
					<span class="px-3 py-1 text-[10px] font-black uppercase tracking-widest bg-white/10 text-white rounded-full border border-white/10 backdrop-blur-sm shadow-xl">
						{cat}
					</span>
				))}
			</div>

			<h1 class="text-5xl md:text-7xl font-black text-transparent bg-clip-text bg-gradient-to-r from-white via-white/90 to-white/50 mb-8 tracking-tight leading-tight">
				{project.titolo}
			</h1>

			{project.linkGithub && (
				<a href={project.linkGithub} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-white text-black px-8 py-4 rounded-full font-bold hover:bg-zinc-200 hover:scale-105 transition-all duration-300 shadow-[0_0_40px_rgba(255,255,255,0.3)]">
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.02c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A4.8 4.8 0 0 0 8 18v4"/><path d="M12 18v-4"/></svg>
					View Source Code
				</a>
			)}
		</div>

		{(() => {
			const displayImage = project.image || project.experienceImage;
			if (!displayImage) return null;
			return (
				<div class="w-full aspect-[21/9] md:aspect-[21/9] rounded-[2rem] overflow-hidden mb-20 border border-white/10 shadow-[0_0_100px_rgba(0,0,0,0.8)] relative group animate-fade-in-up" style="animation-delay: 100ms;">
					<img src={displayImage} alt={project.titolo} class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out" />
					<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
				</div>
			);
		})()}

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-16 animate-fade-in-up" style="animation-delay: 200ms;">
			<div class="lg:col-span-2 prose prose-invert prose-lg md:prose-xl max-w-none">
				<h2 class="text-3xl font-bold text-white mb-6 border-b border-white/10 pb-4 inline-block">Overview</h2>
				<p class="text-white/60 leading-relaxed mb-12 font-light text-xl">
					{project.descrizione}
				</p>
				
				<h2 class="text-3xl font-bold text-white mb-6 border-b border-white/10 pb-4 inline-block">Architecture & Deep Dive</h2>
				<div class="text-white/70 leading-relaxed space-y-6 prose-headings:text-white prose-a:text-blue-400 prose-strong:text-white prose-code:text-emerald-300 prose-code:bg-emerald-900/20 prose-code:px-2 prose-code:py-1 prose-code:rounded-md">
					{project.descrizioneLunga ? (
						<div set:html={project.descrizioneLunga.replace(/\n/g, '<br/>')} />
					) : (
						<div class="bg-white/5 border border-white/10 rounded-2xl p-8 text-center shadow-xl backdrop-blur-sm">
							<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-white/30 mb-4 animate-pulse"><path d="M12 2v4"/><path d="M12 18v4"/><path d="M4.93 4.93l2.83 2.83"/><path d="M16.24 16.24l2.83 2.83"/><path d="M2 12h4"/><path d="M18 12h4"/><path d="M4.93 19.07l2.83-2.83"/><path d="M16.24 7.76l2.83-2.83"/></svg>
							<p class="text-white/50 font-medium">AI analysis is currently processing the architecture...</p>
						</div>
					)}
				</div>
			</div>
			
			<div class="relative">
				<div class="bg-black/40 backdrop-blur-2xl border border-white/10 rounded-3xl p-8 sticky top-32 shadow-2xl">
					<h3 class="text-sm font-black text-white/40 mb-6 uppercase tracking-widest">
						Tech Stack
					</h3>
					<div class="flex flex-col gap-3">
						{project.tecnologie.map((tech) => (
							<div class="flex items-center gap-3 px-4 py-3 bg-white/[0.02] hover:bg-white/[0.05] border border-white/5 rounded-xl transition-colors">
								<div class="w-2 h-2 rounded-full bg-white/30"></div>
								<span class="text-white/80 font-medium text-sm tracking-wide">
									{tech}
								</span>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>

<style>
	.animate-fade-in-up {
		animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
		opacity: 0;
		transform: translateY(20px);
	}
	
	@keyframes fadeInUp {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
