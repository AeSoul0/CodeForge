---
/**
 * @file frontend/src/pages/projects/codeforge.astro
 * @description Dedicated case study page for CodeForge.
 */

import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

const METRICS_URL = "https://github.com/AeSoul0/CodeForge/blob/main/docs/metrics.md";

const engineeringAreas = [
    {
        label: "Architecture",
        value: "Routes → Controllers → Services → Repositories"
    },
    {
        label: "Security",
        value: "JWT Cookie · CSRF Guard · Hash-based CSP · Rate Limiting"
    },
    {
        label: "Testing",
        value: "Vitest · Astro Container API · Playwright · axe-core"
    },
    {
        label: "Delivery",
        value: "GitHub Actions · Vercel ISR · Render · MongoDB Atlas"
    }
];

const platformCapabilities = [
    {
        label: "Frontend",
        value: "Astro + Tailwind CSS + TypeScript modules"
    },
    {
        label: "Backend",
        value: "Fastify + TypeScript on Node.js 24"
    },
    {
        label: "Persistence",
        value: "MongoDB Atlas + Mongoose"
    },
    {
        label: "AI Documentation",
        value: "GitHub Context + OpenAI / Gemini"
    }
];

const qualityChecks = [
    "ESLint and TypeScript (tsc, astro check)",
    "Backend Vitest against a real MongoDB",
    "Frontend unit and rendering tests (90% coverage gate)",
    "Playwright E2E with six parallel workers",
    "axe-core scans of public and admin pages",
    "npm audit, CodeQL and Dependency Review"
];

const securityModel = [
    {
        label: "Authentication",
        text: "JWT (HS256, issuer and audience checked, 24 h expiry) in an HttpOnly, Secure cookie; bcrypt-hashed admin password."
    },
    {
        label: "CSRF Protection",
        text: "Every authenticated mutation must come from an allowed origin and carry an X-Requested-With header that cross-site pages cannot send."
    },
    {
        label: "HTTP Protection",
        text: "Helmet, HSTS, frame-ancestors 'none', referrer policy and a hash-based CSP without 'unsafe-inline' on both the site and the API."
    },
    {
        label: "Abuse Prevention",
        text: "Global per-client rate limiting plus a stricter limit of five login attempts per minute."
    },
    {
        label: "Input Safety",
        text: "Fastify JSON schemas reject unknown fields, oversized values and malformed ids before any business logic runs."
    },
    {
        label: "Output Safety",
        text: "API data reaches the DOM only through textContent and attributes; project Markdown is escaped and its links are allow-listed."
    }
];

// Lighthouse scores out of 100; keep in sync with docs/metrics-lighthouse.json.
const measuredResults = [
    { label: "Performance", desktop: 99, mobile: 92 },
    { label: "Accessibility", desktop: 100, mobile: 100 },
    { label: "Best Practices", desktop: 100, mobile: 100 },
    { label: "SEO", desktop: 100, mobile: 100 }
];
---

<Layout
    title="CodeForge Case Study | ÆSoul"
    description="How CodeForge separates portfolio presentation from content management with an Astro frontend, a secured Fastify API and repository-grounded AI documentation."
>

    <div class="pointer-events-none fixed inset-x-0 top-0 z-0 h-[420px] bg-gradient-to-b from-cyan-500/[0.07] via-transparent to-transparent"></div>

    <!-- Layout.astro already provides the page's <main> landmark. -->
    <div class="relative z-10 mx-auto w-full max-w-4xl px-6 pb-24 pt-28 md:pb-32 md:pt-32">
        <nav class="mb-10 md:mb-14">
            <a
                href="/#projects&experiences"
                class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-sm font-medium text-white/60 backdrop-blur-md transition-all duration-300 hover:border-white/20 hover:bg-white/[0.08] hover:text-white"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="m15 18-6-6 6-6"></path>
                </svg>
                Back to projects
            </a>
        </nav>

        <header class="mb-16">
            <div class="mb-5 flex flex-wrap gap-2">
                <span class="rounded-full border border-cyan-400/20 bg-cyan-400/[0.06] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-cyan-300">
                    Case Study
                </span>
            </div>

            <h1 class="mb-6 text-4xl font-black tracking-[-0.04em] text-white sm:text-5xl md:text-6xl">
                CodeForge
            </h1>

            <div class="prose prose-invert max-w-none prose-p:text-xl prose-p:leading-relaxed prose-p:text-slate-300">
                <p>
                    <strong class="text-white">CodeForge</strong> is the platform behind this portfolio: an Astro
                    site and a protected admin dashboard backed by a Fastify API, with an
                    <span class="text-cyan-400"> evidence-driven AI documentation workflow </span>
                    grounded in each project's public GitHub repository. The system itself is the case study:
                    every claim on this page is backed by code, tests or a production measurement.
                </p>
            </div>

            <!-- Label/value pairs, not section headings: a definition list keeps the
                 heading outline h1 -> h2 for screen-reader users. -->
            <dl class="mt-12 grid grid-cols-2 gap-6 border-y border-white/10 py-8 md:grid-cols-4">
                <div>
                    <dt class="mb-2 text-xs font-semibold uppercase tracking-widest text-slate-500">
                        Role
                    </dt>
                    <dd class="text-sm font-medium text-slate-300">
                        Full-Stack Engineer
                    </dd>
                </div>

                <div>
                    <dt class="mb-2 text-xs font-semibold uppercase tracking-widest text-slate-500">
                        Timeline
                    </dt>
                    <dd class="text-sm font-medium text-slate-300">
                        May 2026 – Present
                    </dd>
                </div>

                <div class="col-span-2">
                    <dt class="mb-2 text-xs font-semibold uppercase tracking-widest text-slate-500">
                        Stack
                    </dt>
                    <dd class="text-sm font-medium text-slate-300">
                        Astro · Tailwind CSS · Fastify · TypeScript · MongoDB · Vercel · Render
                    </dd>
                </div>
            </dl>
        </header>

        <article
            class="prose prose-invert prose-cyan max-w-none
                prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-white
                prose-h2:mt-16 prose-h2:mb-8 prose-h2:border-b prose-h2:border-white/10 prose-h2:pb-4 prose-h2:text-3xl
                prose-h3:mb-4 prose-h3:mt-8 prose-h3:text-xl
                prose-p:mb-6 prose-p:leading-relaxed prose-p:text-slate-400
                prose-li:leading-relaxed prose-li:text-slate-400
                prose-strong:text-slate-200"
        >
            <h2>01. The Problem</h2>

            <div class="mb-8 rounded-2xl border border-white/5 bg-white/[0.02] p-6">
                <p class="mb-4 text-lg text-slate-300">
                    A personal portfolio has to solve two separate engineering problems:
                    presenting technical work clearly and maintaining the content behind it.
                    Hard-coded project pages make every update a code change and couple content management
                    too tightly to the frontend.
                </p>

                <p class="text-lg text-slate-300">
                    At the same time, a GitHub repository alone rarely gives a technical reviewer enough context
                    to understand a project's architecture, decisions, security controls and testing strategy
                    quickly. And a portfolio that only claims engineering quality, without evidence, is easy to dismiss.
                </p>
            </div>

            <div class="h-10 md:h-14"></div>

            <h2>02. Goals</h2>

            <ul>
                <li>
                    <strong>Separate content from presentation:</strong>{" "}
                    projects and experiences are managed from an admin dashboard and stored in a database,
                    not in the frontend source.
                </li>
                <li>
                    <strong>Provide technical depth:</strong>{" "}
                    every project page exposes architecture, implementation decisions and engineering context.
                </li>
                <li>
                    <strong>Automate documentation:</strong>{" "}
                    generate project documentation from repository evidence instead of rewriting it by hand.
                </li>
                <li>
                    <strong>Treat production concerns as features:</strong>{" "}
                    authentication, validation, testing, CI, deployment and observability are part of the scope.
                </li>
                <li>
                    <strong>Prove it with numbers:</strong>{" "}
                    quality is measured (coverage gates, E2E results, production Lighthouse) and published,
                    not asserted.
                </li>
            </ul>

            <div class="h-10 md:h-14"></div>

            <h2>03. Solution Overview</h2>

            <p>
                CodeForge uses a split frontend/backend architecture. The Astro frontend, deployed on Vercel,
                renders the public site and the admin dashboard. A Fastify API on Render owns portfolio data,
                authentication, business logic, persistence in MongoDB Atlas and the AI-assisted documentation.
            </p>

            <div class="not-prose my-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
                {
                    engineeringAreas.map((item) => (
                        <div class="rounded-2xl border border-white/5 bg-white/[0.02] p-6">
                            <span class="mb-2 block text-xs font-semibold uppercase tracking-widest text-slate-500">
                                {item.label}
                            </span>
                            <span class="text-sm font-medium text-slate-200">
                                {item.value}
                            </span>
                        </div>
                    ))
                }
            </div>

            <div class="h-4 md:h-6"></div>

            <h2>04. Architecture</h2>

            <p>
                The backend follows a{" "}
                <strong>Routes → Controllers → Services → Repositories</strong>{" "}
                architecture to keep HTTP concerns, business logic and persistence separate.
                The Fastify application is built separately from the server bootstrap, so the test suite imports
                the fully configured app and exercises it with <code>inject()</code> without opening a network port.
            </p>

            <div class="not-prose my-8 rounded-2xl border border-white/10 bg-black/40 p-6">
                <!-- Screen readers would spell out every box-drawing character, so the
                     diagram is exposed as one image with a prose description. -->
                <pre
                    role="img"
                    aria-label="Architecture diagram. The browser connects over HTTPS, with HSTS and a hash-based CSP, to Vercel, which runs Astro SSR with 300-second ISR and serves bundled TypeScript modules. Next, REST requests with an HttpOnly cookie reach the Fastify API on Render, which applies a CORS allowlist, a CSRF guard, JWT verification and JSON schemas, then passes requests through controllers, services and repositories to MongoDB Atlas via Mongoose. In the background, AI documentation reads GitHub metadata, the README and package.json, uses OpenAI with Gemini as a fallback, and stores Markdown that becomes the project case study."
                    class="overflow-x-auto text-sm leading-relaxed text-slate-300"
                ><code>{`Browser
   │  HTTPS · HSTS · hash-based CSP
   ▼
Vercel ── Astro SSR + ISR (300 s)
   │      bundled TypeScript modules
   │  REST · HttpOnly cookie
   ▼
Render ── Fastify API
   │
   ├── CORS allowlist · CSRF guard
   ├── JWT verification · JSON schemas
   ▼
Controllers → Services → Repositories
   │
   ▼
MongoDB Atlas (Mongoose)

AI Documentation (background)
   │
   ├── GitHub API: metadata, README, package.json
   ├── OpenAI, falling back to Gemini
   ▼
Persisted Markdown → Project Case Study`}</code></pre>
            </div>

            <div class="h-4 md:h-6"></div>

            <h2>05. Key Design Decisions</h2>

            <div class="not-prose my-8 space-y-6">
                <div class="rounded-2xl border border-white/5 bg-white/[0.02] p-6">
                    <h3 class="mb-2 text-lg font-bold text-white">
                        Frontend: Astro without a UI framework runtime
                    </h3>

                    <p class="mb-4 text-sm text-slate-400">
                        <strong class="text-slate-200">Decision:</strong>{" "}
                        Render every page with Astro and implement interactivity (admin dashboard, project filter,
                        particle background) as small TypeScript modules bundled by Astro.
                    </p>

                    <p class="text-sm text-slate-400">
                        <strong class="text-slate-200">Reasoning:</strong>{" "}
                        The site is content-first, so shipping a component framework would add JavaScript without
                        adding value. Bundled modules are unit-testable and let Astro hash every script, which is
                        what makes a CSP without <code>'unsafe-inline'</code> possible. An unused React integration
                        was removed for the same reason.
                    </p>
                </div>

                <div class="rounded-2xl border border-white/5 bg-white/[0.02] p-6">
                    <h3 class="mb-2 text-lg font-bold text-white">
                        Backend: Controller → Service → Repository
                    </h3>

                    <p class="mb-4 text-sm text-slate-400">
                        <strong class="text-slate-200">Decision:</strong>{" "}
                        Keep transport handling, application logic and persistence in separate layers.
                    </p>

                    <p class="text-sm text-slate-400">
                        <strong class="text-slate-200">Reasoning:</strong>{" "}
                        Each layer is tested on its own and HTTP handlers never touch MongoDB directly, so the
                        backend stays easy to reason about and extend.
                    </p>
                </div>

                <div class="rounded-2xl border border-white/5 bg-white/[0.02] p-6">
                    <h3 class="mb-2 text-lg font-bold text-white">
                        Security: cookies across two sites
                    </h3>

                    <p class="mb-4 text-sm text-slate-400">
                        <strong class="text-slate-200">Decision:</strong>{" "}
                        Keep the session JWT in an HttpOnly cookie and add an explicit CSRF guard.
                    </p>

                    <p class="text-sm text-slate-400">
                        <strong class="text-slate-200">Reasoning:</strong>{" "}
                        Frontend and API live on different sites, so the cookie must be <code>SameSite=None</code>,
                        which removes SameSite's built-in CSRF protection. The API therefore checks the request
                        origin and requires a custom header on every authenticated mutation, and login itself is
                        origin-checked.
                    </p>
                </div>

                <div class="rounded-2xl border border-white/5 bg-white/[0.02] p-6">
                    <h3 class="mb-2 text-lg font-bold text-white">
                        AI Documentation: Evidence over Generation
                    </h3>

                    <p class="mb-4 text-sm text-slate-400">
                        <strong class="text-slate-200">Decision:</strong>{" "}
                        Generate documentation from public GitHub repository context rather than relying on
                        unconstrained model output.
                    </p>

                    <p class="text-sm text-slate-400">
                        <strong class="text-slate-200">Implementation:</strong>{" "}
                        CodeForge collects repository metadata, the README and <code>package.json</code>, then
                        supplies that context to OpenAI, falling back to Gemini. Generation runs in the background,
                        so a provider failure never blocks saving a project; the Markdown is normalized, persisted and
                        rendered through a safe Markdown renderer. Existing documentation is only replaced on request.
                    </p>
                </div>

                <div class="rounded-2xl border border-white/5 bg-white/[0.02] p-6">
                    <h3 class="mb-2 text-lg font-bold text-white">
                        Performance: measure, then cache
                    </h3>

                    <p class="mb-4 text-sm text-slate-400">
                        <strong class="text-slate-200">Decision:</strong>{" "}
                        Serve public pages with Vercel ISR (300-second expiration) instead of rendering every request.
                    </p>

                    <p class="text-sm text-slate-400">
                        <strong class="text-slate-200">Evidence:</strong>{" "}
                        The change was made after a Lighthouse baseline and measured afterwards: Performance went
                        from 88 to 96 and LCP from 3.0 s to 2.2 s, without turning the site into a static build.
                    </p>
                </div>
            </div>

            <div class="h-4 md:h-6"></div>

            <h2>06. Implementation Highlights</h2>

            <p>
                The implementation focuses on maintainability and explicit engineering boundaries rather than
                treating the portfolio as a purely visual frontend.
            </p>

            <ul>
                <li>
                    <strong>Fastify API:</strong>{" "}
                    typed REST endpoints with JSON request schemas, one error format and centralized error handling.
                </li>
                <li>
                    <strong>Persistence:</strong>{" "}
                    MongoDB with Mongoose models behind repositories; experience logos are stored in the database
                    and served by the API, so there is no separate file storage.
                </li>
                <li>
                    <strong>Admin dashboard:</strong>{" "}
                    overview, project and experience management with logo upload, an API playground and a system
                    page with liveness, readiness and request metrics.
                </li>
                <li>
                    <strong>AI workflow:</strong>{" "}
                    background, repository-aware documentation generation, triggered on creation or on demand.
                </li>
                <li>
                    <strong>Observability:</strong>{" "}
                    structured request logs with request ids, an audit log for every content change, and{" "}
                    <code>/live</code>, <code>/ready</code> and <code>/metrics</code> endpoints.
                </li>
                <li>
                    <strong>Deployment:</strong>{" "}
                    Vercel for the frontend, Render for the API and MongoDB Atlas for data, with the same Node.js
                    version pinned locally, in CI and in production.
                </li>
            </ul>

            <div class="h-10 md:h-14"></div>

            <h2>07. Testing & Engineering Quality</h2>

            <p>
                Every push and pull request runs the same quality gates in GitHub Actions. A build fails when
                coverage drops below its threshold, when an accessibility scan finds a violation, or when a
                high-severity dependency advisory appears.
            </p>

            <div class="not-prose my-10 grid grid-cols-1 gap-3 sm:grid-cols-2">
                {
                    qualityChecks.map((check) => (
                        <div class="flex items-center gap-3 rounded-xl border border-white/5 bg-white/[0.02] p-4">
                            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-cyan-400/10 text-cyan-300">
                                ✓
                            </span>
                            <span class="text-sm text-slate-300">{check}</span>
                        </div>
                    ))
                }
            </div>

            <p>
                Frontend tests render the real <code>.astro</code> pages with the Astro Container API, and the
                admin tests mount that markup before running the client code, so templates and scripts cannot
                silently drift apart. Test counts and coverage are not copied into prose: CI regenerates them on
                every run in a single{" "}
                <a href={METRICS_URL} target="_blank" rel="noreferrer">metrics file</a>.
            </p>

            <div class="h-4 md:h-6"></div>

            <h2>08. Security Model</h2>

            <div class="not-prose my-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
                {
                    securityModel.map((item) => (
                        <div class="rounded-2xl border border-white/5 bg-white/[0.02] p-6">
                            <span class="mb-3 block text-xs font-semibold uppercase tracking-widest text-slate-500">
                                {item.label}
                            </span>

                            <p class="text-sm leading-relaxed text-slate-300">
                                {item.text}
                            </p>
                        </div>
                    ))
                }
            </div>

            <div class="h-4 md:h-6"></div>

            <h2>09. Results</h2>

            <p>
                The result is a portfolio platform that demonstrates full-stack engineering through the system
                itself rather than through screenshots. Production Lighthouse audit of the homepage on
                20 October 2026: scores out of 100, median of three runs on desktop and three on mobile.
            </p>

            <div class="not-prose my-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
                {
                    measuredResults.map((item) => (
                        <div class="rounded-2xl border border-white/5 bg-white/[0.02] p-6">
                            <span class="mb-2 block text-xs font-semibold uppercase tracking-widest text-slate-500">
                                {item.label}
                            </span>
                            <dl class="flex gap-6">
                                <div>
                                    <dt class="text-xs text-slate-500">Desktop</dt>
                                    <dd class="text-2xl font-bold text-white">{item.desktop}</dd>
                                </div>
                                <div>
                                    <dt class="text-xs text-slate-500">Mobile</dt>
                                    <dd class="text-2xl font-bold text-white">{item.mobile}</dd>
                                </div>
                            </dl>
                        </div>
                    ))
                }
            </div>

            <p>
                Layout shift is zero on both form factors and LCP stays under the 2.5-second target. The platform
                that delivers those numbers is built from:
            </p>

            <div class="not-prose my-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
                {
                    platformCapabilities.map((item) => (
                        <div class="rounded-2xl border border-white/5 bg-white/[0.02] p-6">
                            <span class="mb-2 block text-xs font-semibold uppercase tracking-widest text-slate-500">
                                {item.label}
                            </span>
                            <span class="text-sm font-medium text-slate-200">
                                {item.value}
                            </span>
                        </div>
                    ))
                }
            </div>

            <p>
                More importantly, CodeForge became an engineering evidence platform: portfolio content is stored
                as application data, the administrative workflow is protected against both authentication and
                CSRF attacks, every layer is tested, CI blocks regressions, and technical documentation is
                generated from repository evidence.
            </p>

            <div class="h-14 md:h-20"></div>

            <h2>10. What I Learned</h2>

            <ul>
                <li>
                    <strong>Architecture matters at project scale:</strong>{" "}
                    separating transport, business logic and persistence makes the system substantially easier
                    to test and evolve.
                </li>
                <li>
                    <strong>Deployment shapes the threat model:</strong>{" "}
                    splitting frontend and API across two sites forced <code>SameSite=None</code> cookies, and
                    with them an explicit CSRF defence. Security has to follow the real topology.
                </li>
                <li>
                    <strong>Measure before optimizing:</strong>{" "}
                    ISR was justified by a baseline, and a single slow TTFB sample turned out to be noise once
                    the audit was repeated. One measurement is not evidence.
                </li>
                <li>
                    <strong>AI output needs evidence:</strong>{" "}
                    repository-grounded generation is more useful for technical documentation than unconstrained
                    generation because it reduces unsupported claims.
                </li>
                <li>
                    <strong>Engineering quality is broader than features:</strong>{" "}
                    testing, CI, deployment, observability and documentation are part of the product.
                </li>
            </ul>

            <div class="h-14 md:h-20"></div>

            <h2>11. Future Improvements</h2>

            <p>
                The engineering roadmap is complete; what remains is evidence that needs real users and
                deliberate trade-offs. Next steps are recording field INP from real-user monitoring and
                deeper repository analysis for richer AI documentation.
            </p>
        </article>

        <div class="mt-20 border-t border-white/10 pt-10 text-center">
            <a
                href="https://github.com/AeSoul0/CodeForge"
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-bold text-black shadow-2xl transition-transform duration-300 hover:scale-[1.03]"
            >
                View Source on GitHub

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="17"
                    height="17"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M7 17 17 7"></path>
                    <path d="M7 7h10v10"></path>
                </svg>
            </a>
        </div>
    </div>
</Layout>
